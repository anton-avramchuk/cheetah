<Project>

    <Import Project="version.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- NuGet metadata for all Cheetah.* non-test projects -->
    <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Cheetah')) AND !$(MSBuildProjectName.EndsWith('.Tests'))">
        <IsPackable>true</IsPackable>
        <PackageId>$(MSBuildProjectName)</PackageId>
        <Version>$(CheetahVersion)</Version>
        <Authors>Cheetah CRM Team</Authors>
        <Company>Cheetah CRM</Company>
        <Product>Cheetah CRM Framework</Product>
        <Description>Cheetah CRM Framework — $(MSBuildProjectName)</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <RepositoryType>git</RepositoryType>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

</Project>
