<Project>

    <Import Project="version.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- NuGet metadata for all Cheetah.* non-test projects -->
    <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Cheetah')) AND !$(MSBuildProjectName.EndsWith('.Tests'))">
        <!-- Продакшн-код держим без предупреждений компилятора: любое CS-warning ломает сборку.
             Тестовые проекты намеренно исключены. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- NuGet-аудит (уязвимости транзитивных пакетов) остаётся ВИДИМЫМ warning'ом, но не
             фатальным: новый CVE не должен ронять сборку без изменений в коде. Сами уязвимости
             отслеживаются и устраняются обновлением корневых пакетов (MongoDB.Driver, Microsoft.Data.Sqlite). -->
        <!-- NU5104 (стабильный пакет ссылается на prerelease-зависимость) остаётся видимым warning'ом,
             но не валит pack: Microsoft.OpenApi.Readers 2.0.0 под .NET 10 пока существует только как
             preview — снимем подавление, когда выйдет стабильная версия. -->
        <WarningsNotAsErrors>NU1902;NU1903;NU5104</WarningsNotAsErrors>
        <IsPackable>true</IsPackable>
        <PackageId>$(MSBuildProjectName)</PackageId>
        <Version>$(CheetahVersion)</Version>
        <Authors>Cheetah CRM Team</Authors>
        <Company>Cheetah CRM</Company>
        <Product>Cheetah CRM Framework</Product>
        <Description>Cheetah CRM Framework — $(MSBuildProjectName)</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <RepositoryType>git</RepositoryType>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Неполнота xmldoc терпима и не ломает сборку: CS1591 (нет doc у члена) и
             CS1573 (задокументирована часть параметров). Структурно битый xmldoc
             (CS1570/CS1574/CS1734) НЕ подавляется — это реальные ошибки и остаётся фатальным. -->
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

</Project>
