{
  "$schema": "http://json.schemastore.org/template",
  "author": "Cheetah Team",
  "classifications": ["Cheetah", "Solution", "Monolith", "CRM"],
  "identity": "Cheetah.Monolith.Template",
  "name": "Cheetah Monolith",
  "shortName": "cheetah-monolith",
  "description": "Creates a Cheetah CRM monolith solution with a single ASP.NET Core host referencing Cheetah.* NuGet packages",
  "tags": {
    "language": "C#",
    "type": "solution",
    "ide": "Rider"
  },
  "sourceName": "AppName",
  "preferNameDirectory": true,
  "symbols": {
    "includeIdentity": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include Cheetah.Modules.Identity.* (authentication, JWT, user management)",
      "defaultValue": "false"
    },
    "eventBus": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Event bus backend",
      "defaultValue": "redis",
      "choices": [
        {
          "choice": "redis",
          "description": "Redis pub/sub event bus (production-ready, distributed)"
        },
        {
          "choice": "inmemory",
          "description": "In-memory event bus (no external dependencies, suitable for dev/testing)"
        }
      ]
    },
    "localPackagesPath": {
      "type": "parameter",
      "datatype": "string",
      "description": "Absolute path to local Cheetah NuGet packages directory",
      "defaultValue": "E:\\\\packages",
      "replaces": "__LocalPackagesPath__"
    },
    "cheetahVersion": {
      "type": "parameter",
      "datatype": "string",
      "description": "Cheetah framework NuGet package version",
      "defaultValue": "1.0.0",
      "replaces": "__CheetahVersion__"
    },
    "appNameLower": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "lowerCase",
      "replaces": "appname"
    }
  },
  "forms": {
    "lowerCase": {
      "identifier": "lowerCase"
    }
  },
  "specialCustomOperations": {
    "**/*.json": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["//#if"],
            "else": ["//#else"],
            "elseif": ["//#elseif"],
            "endif": ["//#endif"],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["<!--#if"],
            "else": ["<!--#else"],
            "elseif": ["<!--#elseif"],
            "endif": ["<!--#endif"],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    }
  },
  "primaryOutputs": [
    {
      "path": "AppName.slnx"
    }
  ],
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/obj/**",
            "**/bin/**",
            "**/*.user",
            ".idea/workspace.xml",
            "src/Modules/Identity/**"
          ]
        },
        {
          "condition": "(includeIdentity)",
          "include": [
            "src/Modules/Identity/**"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore' to restore NuGet packages"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4DC3F3AE5FC7",
      "continueOnError": true
    }
  ]
}
