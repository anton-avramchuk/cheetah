<Project Sdk="Microsoft.NET.Sdk.Web">

    <ItemGroup Label="Cheetah Framework">
        <PackageReference Include="Cheetah.AspNetCore" />
        <PackageReference Include="Cheetah.AspNetCore.Contracts" />
        <PackageReference Include="Cheetah.Backend.CQRS" />
        <PackageReference Include="Cheetah.Backend.Endpoints" />
        <PackageReference Include="Cheetah.Backend.Events.Redis" />
        <PackageReference Include="Cheetah.Backend.Jwt" />
        <PackageReference Include="Cheetah.Core" />
        <PackageReference Include="Cheetah.Core.EntityFramework.PostgreSql" />
        <PackageReference Include="Cheetah.CQRS.Dispatcher" />
        <PackageReference Include="Cheetah.Mapping.Mapster" />
        <PackageReference Include="Cheetah.OpenApi" />
        <PackageReference Include="Cheetah.Scalar" />
        <PackageReference Include="Cheetah.ServiceDefaults" />
    </ItemGroup>

<!--#if (includeIdentity)-->
    <ItemGroup Label="Cheetah Modules">
        <PackageReference Include="Cheetah.Modules.Identity.Api" />
        <ProjectReference Include="..\Modules\Identity\AppName.Identity.DataAccess\AppName.Identity.DataAccess.csproj" />
    </ItemGroup>

<!--#endif-->
    <ItemGroup Label="Modules">
        <ProjectReference Include="..\Modules\AppName\AppName.Api\AppName.Api.csproj" />
        <ProjectReference Include="..\Modules\AppName\AppName.DataAccess\AppName.DataAccess.csproj" />
    </ItemGroup>

    <ItemGroup Label="Source Generators">
        <PackageReference Include="Cheetah.Generators.Module">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Cheetah.Generators.Application">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Cheetah.Generators.Endpoints">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
