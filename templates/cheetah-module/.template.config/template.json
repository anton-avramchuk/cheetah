{
  "$schema": "http://json.schemastore.org/template",
  "author": "Cheetah Team",
  "classifications": ["Cheetah", "Module", "DDD"],
  "identity": "Cheetah.Module.Template",
  "name": "Cheetah Module",
  "shortName": "cheetah-module",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "ModuleName",
  "preferNameDirectory": false,
  "symbols": {
    "includeEntity": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include sample entity with CRUD operations",
      "defaultValue": "true"
    },
    "prefix": {
      "type": "parameter",
      "datatype": "string",
      "description": "The namespace prefix (e.g., Crm, Cheetah.Admin.Modules)",
      "defaultValue": "Crm",
      "replaces": "__Prefix__",
      "fileRename": "__Prefix__"
    },
    "classPrefix": {
      "type": "derived",
      "valueSource": "prefix",
      "valueTransform": "RemoveDots",
      "replaces": "__ClassPrefix__",
      "fileRename": "__ClassPrefix__"
    },
    "schema": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      },
      "replaces": "moduleschema"
    },
    "entity": {
      "type": "parameter",
      "datatype": "string",
      "description": "Example entity name (singular, PascalCase)",
      "defaultValue": "Entity",
      "replaces": "SampleEntity",
      "fileRename": "SampleEntity"
    },
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "parameters": {
        "format": "yyyy"
      },
      "replaces": "2024"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/obj/**",
            "**/bin/**",
            "**/*.user",
            "**/SampleEntityCrudServiceTests.cs"
          ]
        },
        {
          "condition": "(!includeEntity)",
          "exclude": [
            "**/SampleEntity.cs",
            "**/SampleEntity*.cs",
            "**/Commands/**",
            "**/Queries/**",
            "**/Endpoints/**",
            "**/Requests/**",
            "**/Response/**",
            "**/Configurations/**",
            "**/Repositories/**",
            "**/Mapping/**",
            "**/Constants.cs",
            "**/SampleEntityModel.cs",
            "**/*.Tests/**"
          ]
        }
      ]
    }
  ],
  "forms": {
    "RemoveDots": {
      "identifier": "replace",
      "pattern": "\\.",
      "replacement": ""
    }
  },
  "postActions": [
    {
      "description": "Add projects to solution",
      "manualInstructions": [
        {
          "text": "Add all generated projects to your solution file using: dotnet sln add <project-paths>"
        }
      ],
      "actionId": "D396686C-DE0E-4DE6-906D-291CD29FC5DE",
      "continueOnError": true
    }
  ]
}
