@page "/moduleschema/sampleentities"
@namespace __Prefix__.ModuleName.Frontend.Pages

@inject ICrudService<SampleEntityGridViewModel, SampleEntityFormModel, SampleEntityFormModel> CrudService

<PageTitle>SampleEntity List</PageTitle>

<CrmCrudGrid TGridViewModel="SampleEntityGridViewModel"
             TCreateViewModel="SampleEntityFormModel"
             TEditViewModel="SampleEntityFormModel"
             Service="CrudService"
             Title="SampleEntity List"
             CreateFormType="typeof(SampleEntityForm)"
             EditFormType="typeof(SampleEntityForm)"
             CreateDialogTitle="New SampleEntity"
             EditDialogTitle="Edit SampleEntity"
             CreateButtonText="Add"
             EmptyMessage="No entities found"
             AllowCreate="true"
             AllowEdit="true"
             AllowDelete="true" />
