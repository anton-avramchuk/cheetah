@namespace __Prefix__.ModuleName.Frontend.Components

@using __Prefix__.ModuleName.Frontend.Models
@using __Prefix__.ModuleName.ApiClient
@using Cheetah.Blazor.Components
@using Cheetah.Blazor.Components.Dialogs
@using Cheetah.Blazor.Components.Feedback
@using Cheetah.Blazor.Components.Forms
@using Microsoft.AspNetCore.Components.Forms

@implements IDialogForm<SampleEntityFormModel>

@if (_isLoading)
{
    <div class="text-center py-4">
        <CrmLoadingSpinner Message="Loading..." />
    </div>
}
else
{
    <EditForm Model="_model" @ref="_editFormRef">
        <DataAnnotationsValidator />

        <CrmTextInput TValue="string"
                      @bind-Value="_model.Name"
                      Label="Name"
                      Placeholder="Enter name"
                      Required="true"
                      ValidationFor="() => _model.Name" />

        <CrmTextArea @bind-Value="_model.Description"
                     Label="Description"
                     Placeholder="Enter description"
                     Rows="3"
                     ValidationFor="() => _model.Description" />

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <CrmAlert Variant="ColorVariant.Danger" Message="@_errorMessage" />
        }
    </EditForm>
}

@code {
    [CascadingParameter]
    public IDialogFormContext? DialogContext { get; set; }

    /// <summary>
    /// Entity ID for edit mode. If null, creates new entity.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    [Inject]
    private IModuleNameService Service { get; set; } = null!;

    private SampleEntityFormModel _model = new();
    private EditForm? _editFormRef;
    private EditContext? _editContext;
    private bool _isLoading;
    private string? _errorMessage;

    public EditContext? EditContext => _editContext;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            _isLoading = true;
            try
            {
                var entity = await Service.GetByIdAsync(Id.Value);
                if (entity != null)
                {
                    _model = new SampleEntityFormModel
                    {
                        Id = entity.Id,
                        Name = entity.Name,
                        Description = entity.Description ?? ""
                    };
                }
                else
                {
                    _errorMessage = "Entity not found";
                }
            }
            catch (Exception ex)
            {
                _errorMessage = $"Load error: {ex.Message}";
            }
            finally
            {
                _isLoading = false;
            }
        }

        _editContext = new EditContext(_model);
        DialogContext?.RegisterEditContext(_editContext);
    }

    public Task<DialogFormResult<SampleEntityFormModel>> SubmitAsync()
    {
        if (_editContext == null || !_editContext.Validate())
        {
            return Task.FromResult(DialogFormResult<SampleEntityFormModel>.Fail("Please fix validation errors"));
        }

        return Task.FromResult(DialogFormResult<SampleEntityFormModel>.Ok(_model));
    }
}
