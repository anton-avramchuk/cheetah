<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- Kiota-generated code is not warning-clean; don't fail the proof build on its warnings. -->
        <NoWarn>$(NoWarn);CS1591;CS8602;CS8604;CS0618</NoWarn>
        <!-- Path to the built generator tool (built first via the ProjectReference below). -->
        <ApiClientGenDll>$(MSBuildThisFileDirectory)..\..\tools\Cheetah.ApiClientGen\bin\$(Configuration)\net10.0\Cheetah.ApiClientGen.dll</ApiClientGenDll>
    </PropertyGroup>

    <ItemGroup>
        <!-- Runtime packages the Kiota-generated REST client needs (abstractions + serialization + HTTP). -->
        <PackageReference Include="Microsoft.Kiota.Bundle" />
    </ItemGroup>

    <ItemGroup>
        <!-- gRPC: Grpc.Tools generates C# from the fetched .proto at build; the rest are runtime. -->
        <PackageReference Include="Grpc.Tools">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Grpc.Net.Client" />
        <PackageReference Include="Google.Protobuf" />
    </ItemGroup>

    <!--
      No per-client <Protobuf> lines needed: Cheetah.ApiClientGen fetches each .proto and registers it
      with Grpc.Tools automatically from apiclients.json (see the tool's .targets).
    -->

    <ItemGroup>
        <!-- Ensures the generator tool is built before this project compiles; we run its DLL, not reference it. -->
        <ProjectReference Include="..\..\tools\Cheetah.ApiClientGen\Cheetah.ApiClientGen.csproj"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Import Project="..\..\tools\Cheetah.ApiClientGen\Cheetah.ApiClientGen.targets" />

</Project>
