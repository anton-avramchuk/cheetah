@namespace Cheetah.Frontend.Auth.Components
@implements IDisposable
@using Cheetah.Frontend.Navigation.Constants
@using Cheetah.Frontend.Navigation.Models
@using Cheetah.Frontend.Navigation.Services.Abstractions
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

@inject AuthenticationStateProvider AuthStateProvider
@inject IMenuProvider MenuProvider
@inject NavigationManager Navigation

@if (_isAuthenticated)
{
    <div class="crm-user-info @(_isOpen ? "open" : "")" @onclick="Toggle">
        <span class="crm-user-avatar">@_avatarLetter</span>
        <span class="crm-user-name">@_displayName</span>
        <i class="bi @(_isOpen ? "bi-chevron-up" : "bi-chevron-down") crm-user-chevron"></i>

        @if (_isOpen)
        {
            <div class="crm-user-dropdown" role="menu" @onclick:stopPropagation="true">
                @foreach (var item in _menuItems)
                {
                    <a class="crm-user-dropdown-item @(item.IsDisabled ? "disabled" : "")"
                       href="@item.Url"
                       target="@item.Target"
                       role="menuitem">
                        @if (!string.IsNullOrEmpty(item.IconName))
                        {
                            <i class="bi bi-@item.IconName"></i>
                        }
                        <span>@item.Name</span>
                    </a>
                }
            </div>
            <div class="crm-user-backdrop" @onclick="Close" @onclick:stopPropagation="true"></div>
        }
    </div>
}

@code {
    private bool _isAuthenticated;
    private bool _isOpen;
    private string _displayName = string.Empty;
    private string _avatarLetter = "?";
    private List<MenuItem> _menuItems = [];

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await LoadStateAsync(await AuthStateProvider.GetAuthenticationStateAsync());
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            await LoadStateAsync(await task);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _isOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadStateAsync(AuthenticationState state)
    {
        _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
        _isOpen = false;

        if (_isAuthenticated)
        {
            _displayName = state.User.FindFirst("unique_name")?.Value
                        ?? state.User.FindFirst("email")?.Value
                        ?? "User";
            _avatarLetter = _displayName.Length > 0
                ? _displayName[0].ToString().ToUpperInvariant()
                : "?";
        }

        var menu = await MenuProvider.GetMenuAsync(StandardMenus.User);
        _menuItems = menu?.Items.Where(i => i.IsVisible).OrderBy(i => i.Order).ToList() ?? [];
    }

    private void Toggle() => _isOpen = !_isOpen;

    private void Close() => _isOpen = false;

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
