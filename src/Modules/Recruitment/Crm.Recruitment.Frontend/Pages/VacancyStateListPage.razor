@page "/dictionary/vacancy-states"
@namespace Crm.Recruitment.Frontend.Pages

@inject ICrudService<VacancyStateGridViewModel, VacancyStateFormModel, VacancyStateFormModel> CrudService

<PageTitle>Vacancy States</PageTitle>

<CrmCrudGrid TGridViewModel="VacancyStateGridViewModel"
             TCreateViewModel="VacancyStateFormModel"
             TEditViewModel="VacancyStateFormModel"
             Service="CrudService"
             Title="Vacancy States"
             CreateFormType="typeof(VacancyStateForm)"
             EditFormType="typeof(VacancyStateForm)"
             CreateDialogTitle="New Vacancy State"
             EditDialogTitle="Edit Vacancy State"
             CreateButtonText="Add"
             EmptyMessage="No vacancy states found"
             AllowCreate="true"
             AllowEdit="true"
             AllowDelete="true"/>
