@page "/vacancies"
@namespace Crm.Recruitment.Frontend.Pages

@inject IGridService<VacancyGridViewModel> GridService

<PageTitle>Vacancy List</PageTitle>

<CrmNavCrudGrid TGridViewModel="VacancyGridViewModel"
               Service="GridService"
               Title="Vacancy List"
               CreateUrl="/vacancies/create"
               EditUrl="/vacancies/{0}/edit"
               CreateButtonText="Add"
               EmptyMessage="No vacancies found"
               AllowCreate="true"
               AllowEdit="true"
               AllowDelete="true"/>
