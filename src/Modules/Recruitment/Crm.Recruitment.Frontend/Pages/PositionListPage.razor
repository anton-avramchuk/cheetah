@page "/dictionary/positions"
@namespace Crm.Recruitment.Frontend.Pages

@inject ICrudService<PositionGridViewModel, PositionFormModel, PositionFormModel> CrudService

<PageTitle>Positions</PageTitle>

<CrmCrudGrid TGridViewModel="PositionGridViewModel"
             TCreateViewModel="PositionFormModel"
             TEditViewModel="PositionFormModel"
             Service="CrudService"
             Title="Positions"
             CreateFormType="typeof(PositionForm)"
             EditFormType="typeof(PositionForm)"
             CreateDialogTitle="New Position"
             EditDialogTitle="Edit Position"
             CreateButtonText="Add"
             EmptyMessage="No positions found"
             AllowCreate="true"
             AllowEdit="true"
             AllowDelete="true"/>
