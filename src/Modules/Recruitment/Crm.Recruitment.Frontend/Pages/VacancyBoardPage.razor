@page "/vacancies/board"
@namespace Crm.Recruitment.Frontend.Pages

@using Cheetah.Blazor.Components
@using Cheetah.Blazor.Components.Feedback
@using Cheetah.Blazor.Components.Kanban
@using Cheetah.Blazor.Components.SlideOver
@using Crm.Recruitment.ApiClient
@using Crm.Recruitment.Contracts.Requests
@using Crm.Recruitment.Contracts.Response

@inject IVacanciesService VacanciesService
@inject IVacancyStatesService VacancyStatesService
@inject NavigationManager Navigation

<PageTitle>Vacancy Board</PageTitle>

@if (_isLoading)
{
    <div class="text-center py-5">
        <CrmLoadingSpinner Message="Loading board..." />
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <CrmAlert Variant="ColorVariant.Danger" Message="@_errorMessage" />
}
else
{
    <CrmKanbanBoard TItem="VacancyViewModel"
                    OnItemMoved="OnItemMovedAsync"
                    OnCardClick="OnCardClick">
        <CardTemplate>
            <div class="crm-kanban-card-content">
                <div class="fw-semibold mb-1">@context.Name</div>
                @if (!string.IsNullOrEmpty(context.CustomerCode) || !string.IsNullOrEmpty(context.CustomerName))
                {
                    <div class="mb-1">
                        @if (!string.IsNullOrEmpty(context.CustomerCode))
                        {
                            <span class="badge bg-primary-subtle text-primary me-1">@context.CustomerCode</span>
                        }
                        @if (!string.IsNullOrEmpty(context.CustomerName))
                        {
                            <small class="text-muted">@context.CustomerName</small>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(context.PositionName))
                {
                    <div>
                        <small class="text-muted"><i class="bi bi-person me-1"></i>@context.PositionName</small>
                    </div>
                }
            </div>
        </CardTemplate>
        <ChildContent>
            @foreach (var state in _states)
            {
                var stateId = state.Id.ToString();
                var items = _vacanciesByState.TryGetValue(state.Id, out var list) ? list : [];

                <CrmKanbanColumn TItem="VacancyViewModel"
                                 Id="@stateId"
                                 Title="@state.Name"
                                 Items="items">
                    <HeaderTemplate>
                        <div class="d-flex justify-content-between align-items-center"
                             style="border-top: 3px solid @(state.Color ?? "#6c757d"); padding-top: 0.5rem;">
                            <span class="crm-kanban-column-title">@state.Name</span>
                            <span class="badge bg-secondary">@items.Count</span>
                        </div>
                    </HeaderTemplate>
                </CrmKanbanColumn>
            }
        </ChildContent>
    </CrmKanbanBoard>
}

<CrmSlideOver @ref="_slideOver"
              @bind-IsVisible="_slideOverVisible"
              Title="@_selectedVacancy?.Name"
              ExternalUrl="@(_selectedVacancy != null ? $"/vacancies/{_selectedVacancy.Id}/edit" : null)">
    @if (_selectedVacancy != null)
    {
        <Crm.Recruitment.Frontend.Components.VacancySlideOverForm
            Id="_selectedVacancy.Id"
            OnSaved="OnVacancySavedAsync" />
    }
</CrmSlideOver>

@code {
    private List<VacancyStateViewModel> _states = [];
    private Dictionary<Guid, List<VacancyViewModel>> _vacanciesByState = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    private CrmSlideOver? _slideOver;
    private bool _slideOverVisible;
    private VacancyViewModel? _selectedVacancy;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var statesTask = VacancyStatesService.GetAllAsync().AsTask();
            var vacanciesTask = VacanciesService.GetAllAsync(null).AsTask();

            await Task.WhenAll(statesTask, vacanciesTask);

            _states = statesTask.Result.OrderBy(s => s.Order).ToList();
            var stateIds = _states.Select(s => s.Id).ToHashSet();

            var vacancies = vacanciesTask.Result.Data;
            _vacanciesByState = _states.ToDictionary(
                s => s.Id,
                s => vacancies
                    .Where(v => v.StateId == s.Id)
                    .OrderBy(v => v.Order)
                    .ToList());

            // Vacancies without state go to the first column
            var unassigned = vacancies.Where(v => v.StateId == null || !stateIds.Contains(v.StateId.Value)).ToList();
            if (unassigned.Count > 0 && _states.Count > 0)
            {
                _vacanciesByState[_states[0].Id].AddRange(unassigned);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load board: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnItemMovedAsync(KanbanItemMovedEventArgs<VacancyViewModel> args)
    {
        if (!Guid.TryParse(args.TargetColumnId, out var targetStateId))
            return;

        // Optimistic update
        if (Guid.TryParse(args.SourceColumnId, out var sourceStateId)
            && _vacanciesByState.TryGetValue(sourceStateId, out var sourceList))
        {
            sourceList.Remove(args.Item);
        }

        var movedItem = args.Item with { StateId = targetStateId, Order = args.TargetIndex };

        if (_vacanciesByState.TryGetValue(targetStateId, out var targetList))
        {
            var index = Math.Min(args.TargetIndex, targetList.Count);
            targetList.Insert(index, movedItem);
        }

        try
        {
            var request = new MoveVacancyRequest(args.Item.Id, targetStateId, args.TargetIndex);
            await VacanciesService.PatchAsync(args.Item.Id, request);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to move vacancy: {ex.Message}";
            await LoadDataAsync();
        }
    }

    private void OnCardClick(VacancyViewModel vacancy)
    {
        _selectedVacancy = vacancy;
        _slideOverVisible = true;
    }

    private async Task OnVacancySavedAsync()
    {
        _slideOverVisible = false;
        _selectedVacancy = null;
        StateHasChanged();
        await LoadDataAsync();
        StateHasChanged();
    }
}
