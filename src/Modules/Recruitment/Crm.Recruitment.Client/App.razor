@using Cheetah.Blazor.Routing
@inject IRoutableAssemblyProvider RoutableAssemblyProvider

<Router AppAssembly="@typeof(App).Assembly"
        AdditionalAssemblies="@RoutableAssemblyProvider.GetRoutableAssemblies()"
        NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Cheetah.Blazor.Layout.Components.CrmMainLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
    </Found>
</Router>
