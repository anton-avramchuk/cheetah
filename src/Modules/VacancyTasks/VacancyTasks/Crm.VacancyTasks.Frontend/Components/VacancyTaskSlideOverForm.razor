@namespace Crm.VacancyTasks.Frontend.Components

@using Cheetah.Blazor.Components
@using Cheetah.Blazor.Components.Buttons
@using Cheetah.Blazor.Components.Feedback
@using Cheetah.Blazor.Components.Forms
@using Cheetah.Core.Cache
@using Crm.VacancyTasks.ApiClient
@using Crm.VacancyTasks.Contracts.Requests
@using Crm.VacancyTasks.Contracts.Response
@using Crm.VacancyTasks.Frontend.Models
@using Microsoft.AspNetCore.Components.Forms

@inject IVacancyTasksService VacancyTasksService
@inject ITaskStatesService TaskStatesService
@inject ITaskPrioritiesService TaskPrioritiesService
@inject ICacheService Cache

@if (_isLoading)
{
    <div class="text-center py-4">
        <CrmLoadingSpinner Message="Loading..." />
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage) && _model == null)
{
    <CrmAlert Variant="ColorVariant.Danger" Message="@_errorMessage" />
}
else if (_model != null)
{
    <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <CrmTextInput TValue="string"
                      @bind-Value="_model.Title"
                      Label="Title"
                      Placeholder="Enter title"
                      Required="true"
                      ValidationFor="() => _model.Title" />

        <CrmTextArea @bind-Value="_model.Description"
                     Label="Description"
                     Placeholder="Enter description"
                     Rows="3"
                     ValidationFor="() => _model.Description" />

        <div class="mb-3">
            <label class="form-label">State</label>
            <InputSelect class="form-select" @bind-Value="_model.StateId">
                @foreach (var item in _states)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Priority</label>
            <InputSelect class="form-select" @bind-Value="_model.PriorityId">
                <option value="">-- Not selected --</option>
                @foreach (var item in _priorities)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Due Date</label>
            <InputDate class="form-control" @bind-Value="_model.DueDate" />
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <CrmAlert Variant="ColorVariant.Danger" Message="@_errorMessage" Dismissible="true" />
        }

        <div class="d-flex gap-2 mt-3">
            <CrmButton Text="Save"
                       Icon="check-lg"
                       Type="submit"
                       Disabled="_isSaving" />
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private VacancyTaskFormModel? _model;
    private string? _errorMessage;
    private bool _isLoading = true;
    private bool _isSaving;

    private IReadOnlyList<TaskStateViewModel> _states = [];
    private IReadOnlyList<TaskPriorityViewModel> _priorities = [];

    private static readonly TimeSpan CacheTtl = TimeSpan.FromMinutes(5);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var taskTask = VacancyTasksService.GetByIdAsync(Id).AsTask();
            var statesTask = Cache.GetOrSetAsync(VacancyTasksCacheKeys.TaskStates,
                () => TaskStatesService.GetAllAsync(), CacheTtl).AsTask();
            var prioritiesTask = Cache.GetOrSetAsync(VacancyTasksCacheKeys.TaskPriorities,
                () => TaskPrioritiesService.GetAllAsync(), CacheTtl).AsTask();

            await Task.WhenAll(taskTask, statesTask, prioritiesTask);

            _states = statesTask.Result;
            _priorities = prioritiesTask.Result;

            var entity = taskTask.Result;
            if (entity != null)
            {
                _model = new VacancyTaskFormModel
                {
                    Id = entity.Id,
                    Title = entity.Title,
                    Description = entity.Description ?? "",
                    VacancyId = entity.VacancyId,
                    StateId = entity.StateId,
                    PriorityId = entity.PriorityId,
                    AssigneeId = entity.AssigneeId,
                    DueDate = entity.DueDate
                };
            }
            else
            {
                _errorMessage = "Task not found";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Load error: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_model == null) return;

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var description = string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description;
            var request = new UpdateVacancyTaskRequest(Id, _model.Title, description, _model.StateId, _model.PriorityId, _model.DueDate);
            await VacancyTasksService.UpdateAsync(Id, request);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error saving: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
