@namespace Crm.VacancyTasks.Frontend.Components

@using Crm.VacancyTasks.Frontend.Models
@using Crm.VacancyTasks.ApiClient
@using Cheetah.Blazor.Components
@using Cheetah.Blazor.Components.Dialogs
@using Cheetah.Blazor.Components.Feedback
@using Cheetah.Blazor.Components.Forms
@using Microsoft.AspNetCore.Components.Forms

@implements IDialogForm<TaskStateFormModel>

@if (_isLoading)
{
    <div class="text-center py-4">
        <CrmLoadingSpinner Message="Loading..."/>
    </div>
}
else
{
    <EditForm Model="_model" @ref="_editFormRef">
        <DataAnnotationsValidator/>

        <CrmTextInput TValue="string"
                      @bind-Value="_model.Name"
                      Label="Name"
                      Placeholder="Enter name"
                      Required="true"
                      ValidationFor="() => _model.Name"/>

        <div class="mb-3">
            <label class="form-label">Order</label>
            <InputNumber class="form-control" @bind-Value="_model.Order"/>
        </div>

        <CrmTextInput TValue="string?"
                      @bind-Value="_model.Color"
                      Label="Color"
                      Placeholder="Enter color (e.g. #FF0000)"
                      ValidationFor="() => _model.Color"/>

        <div class="mb-3 form-check">
            <InputCheckbox class="form-check-input" @bind-Value="_model.IsDefault"/>
            <label class="form-check-label">Is Default</label>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <CrmAlert Variant="ColorVariant.Danger" Message="@_errorMessage"/>
        }
    </EditForm>
}

@code {
    [CascadingParameter] public IDialogFormContext? DialogContext { get; set; }

    [Parameter]
    public Guid? Id { get; set; }

    [Inject] private ITaskStatesService Service { get; set; } = null!;

    private TaskStateFormModel _model = new();
    private EditForm? _editFormRef;
    private EditContext? _editContext;
    private bool _isLoading;
    private string? _errorMessage;

    public EditContext? EditContext => _editContext;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            _isLoading = true;
            try
            {
                var entity = await Service.GetByIdAsync(Id.Value);
                if (entity != null)
                {
                    _model = new TaskStateFormModel
                    {
                        Id = entity.Id,
                        Name = entity.Name,
                        Order = entity.Order,
                        Color = entity.Color,
                        IsDefault = entity.IsDefault
                    };
                }
                else
                {
                    _errorMessage = "Entity not found";
                }
            }
            catch (Exception ex)
            {
                _errorMessage = $"Load error: {ex.Message}";
            }
            finally
            {
                _isLoading = false;
            }
        }

        _editContext = new EditContext(_model);
        DialogContext?.RegisterEditContext(_editContext);
    }

    public Task<DialogFormResult<TaskStateFormModel>> SubmitAsync()
    {
        if (_editContext == null || !_editContext.Validate())
        {
            return Task.FromResult(DialogFormResult<TaskStateFormModel>.Fail("Please fix validation errors"));
        }

        return Task.FromResult(DialogFormResult<TaskStateFormModel>.Ok(_model));
    }
}
