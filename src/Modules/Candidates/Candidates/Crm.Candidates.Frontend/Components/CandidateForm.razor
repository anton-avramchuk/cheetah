@namespace Crm.Candidates.Frontend.Components

@using Crm.Candidates.Frontend.Models
@using Crm.Candidates.ApiClient
@using Cheetah.Blazor.Components
@using Cheetah.Blazor.Components.Dialogs
@using Cheetah.Blazor.Components.Feedback
@using Cheetah.Blazor.Components.Forms
@using Microsoft.AspNetCore.Components.Forms

@implements IDialogForm<CandidateFormModel>

@if (_isLoading)
{
    <div class="text-center py-4">
        <CrmLoadingSpinner Message="Loading..."/>
    </div>
}
else
{
    <EditForm Model="_model" @ref="_editFormRef">
        <DataAnnotationsValidator/>

        <CrmTextInput TValue="string"
                      @bind-Value="_model.FirstName"
                      Label="First Name"
                      Placeholder="Enter first name"
                      Required="true"
                      ValidationFor="() => _model.FirstName"/>

        <CrmTextInput TValue="string"
                      @bind-Value="_model.LastName"
                      Label="Last Name"
                      Placeholder="Enter last name"
                      Required="true"
                      ValidationFor="() => _model.LastName"/>

        <CrmTextInput TValue="string?"
                      @bind-Value="_model.Email"
                      Label="Email"
                      Placeholder="Enter email"
                      ValidationFor="() => _model.Email"/>

        <CrmTextInput TValue="string?"
                      @bind-Value="_model.Phone"
                      Label="Phone"
                      Placeholder="Enter phone"
                      ValidationFor="() => _model.Phone"/>

        <CrmTextInput TValue="string?"
                      @bind-Value="_model.City"
                      Label="City"
                      Placeholder="Enter city"
                      ValidationFor="() => _model.City"/>

        <CrmTextInput TValue="string?"
                      @bind-Value="_model.CurrentPosition"
                      Label="Current Position"
                      Placeholder="Enter current position"
                      ValidationFor="() => _model.CurrentPosition"/>

        <CrmTextInput TValue="string?"
                      @bind-Value="_model.CurrentCompany"
                      Label="Current Company"
                      Placeholder="Enter current company"
                      ValidationFor="() => _model.CurrentCompany"/>

        <CrmTextArea @bind-Value="_model.About"
                     Label="About"
                     Placeholder="Enter about info"
                     Rows="3"
                     ValidationFor="() => _model.About"/>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <CrmAlert Variant="ColorVariant.Danger" Message="@_errorMessage"/>
        }
    </EditForm>
}

@code {
    [CascadingParameter] public IDialogFormContext? DialogContext { get; set; }

    /// <summary>
    /// Entity ID for edit mode. If null, creates new entity.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    [Inject] private ICandidatesService Service { get; set; } = null!;

    private CandidateFormModel _model = new();
    private EditForm? _editFormRef;
    private EditContext? _editContext;
    private bool _isLoading;
    private string? _errorMessage;

    public EditContext? EditContext => _editContext;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            _isLoading = true;
            try
            {
                var entity = await Service.GetByIdAsync(Id.Value);
                if (entity != null)
                {
                    _model = new CandidateFormModel
                    {
                        Id = entity.Id,
                        FirstName = entity.FirstName,
                        LastName = entity.LastName,
                        Email = entity.Email,
                        Phone = entity.Phone,
                        City = entity.City,
                        CurrentPosition = entity.CurrentPosition,
                        CurrentCompany = entity.CurrentCompany,
                        SalaryExpectation = entity.SalaryExpectation,
                        About = entity.About
                    };
                }
                else
                {
                    _errorMessage = "Entity not found";
                }
            }
            catch (Exception ex)
            {
                _errorMessage = $"Load error: {ex.Message}";
            }
            finally
            {
                _isLoading = false;
            }
        }

        _editContext = new EditContext(_model);
        DialogContext?.RegisterEditContext(_editContext);
    }

    public Task<DialogFormResult<CandidateFormModel>> SubmitAsync()
    {
        if (_editContext == null || !_editContext.Validate())
        {
            return Task.FromResult(DialogFormResult<CandidateFormModel>.Fail("Please fix validation errors"));
        }

        return Task.FromResult(DialogFormResult<CandidateFormModel>.Ok(_model));
    }

}
