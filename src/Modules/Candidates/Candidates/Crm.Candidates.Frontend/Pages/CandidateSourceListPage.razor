@page "/dictionary/candidate-sources"
@namespace Crm.Candidates.Frontend.Pages

@inject ICrudService<CandidateSourceGridViewModel, CandidateSourceFormModel, CandidateSourceFormModel> CrudService

<PageTitle>Candidate Sources</PageTitle>

<CrmCrudGrid TGridViewModel="CandidateSourceGridViewModel"
             TCreateViewModel="CandidateSourceFormModel"
             TEditViewModel="CandidateSourceFormModel"
             Service="CrudService"
             Title="Candidate Sources"
             CreateFormType="typeof(CandidateSourceForm)"
             EditFormType="typeof(CandidateSourceForm)"
             CreateDialogTitle="New Candidate Source"
             EditDialogTitle="Edit Candidate Source"
             CreateButtonText="Add"
             EmptyMessage="No candidate sources found"
             AllowCreate="true"
             AllowEdit="true"
             AllowDelete="true"/>
