{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Yarp": {
    "Routes": {
      "candidatesRoute": {
        "ClusterId": "candidatesCluster",
        "Order": 1,
        "Match": {
          "Path": "/api/recruitment/candidates/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/recruitment" }
        ]
      },
      "candidateStagesRoute": {
        "ClusterId": "candidatesCluster",
        "Order": 1,
        "Match": {
          "Path": "/api/recruitment/candidate-stages/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/recruitment" }
        ]
      },
      "candidateSourcesRoute": {
        "ClusterId": "candidatesCluster",
        "Order": 1,
        "Match": {
          "Path": "/api/recruitment/candidate-sources/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/recruitment" }
        ]
      },
      "candidateApplicationsRoute": {
        "ClusterId": "candidatesCluster",
        "Order": 1,
        "Match": {
          "Path": "/api/recruitment/candidate-applications/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/recruitment" }
        ]
      },
      "vacancyTasksRoute": {
        "ClusterId": "vacancyTasksCluster",
        "Order": 1,
        "Match": {
          "Path": "/api/recruitment/vacancy-tasks/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/recruitment" }
        ]
      },
      "taskStatesRoute": {
        "ClusterId": "vacancyTasksCluster",
        "Order": 1,
        "Match": {
          "Path": "/api/recruitment/task-states/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/recruitment" }
        ]
      },
      "taskPrioritiesRoute": {
        "ClusterId": "vacancyTasksCluster",
        "Order": 1,
        "Match": {
          "Path": "/api/recruitment/task-priorities/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/recruitment" }
        ]
      },
      "recruitmentRoute": {
        "ClusterId": "recruitmentCluster",
        "Order": 100,
        "Match": {
          "Path": "/api/recruitment/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/recruitment" }
        ]
      }
    },
    "Clusters": {
      "recruitmentCluster": {
        "Destinations": {
          "recruitmentDestination": {
            "Address": "http://crm-recruitment-api/api"
          }
        }
      },
      "candidatesCluster": {
        "Destinations": {
          "candidatesDestination": {
            "Address": "http://candidates-api/api"
          }
        }
      },
      "vacancyTasksCluster": {
        "Destinations": {
          "vacancyTasksDestination": {
            "Address": "http://vacancyTasks-api/api"
          }
        }
      }
    }
  }
}
