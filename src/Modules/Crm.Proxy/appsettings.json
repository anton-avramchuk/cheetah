{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Yarp": {
    "Routes": {
      "recruitmentRoute": {
        "ClusterId": "recruitmentCluster",
        "Match": {
          "Path": "/recruitment/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/recruitment"
          }
        ]
      },
      "candidatesRoute": {
        "ClusterId": "candidatesCluster",
        "Match": {
          "Path": "/candidates/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/candidates"
          }
        ]
      },
      "vacancyTasksRoute": {
        "ClusterId": "vacancyTasksCluster",
        "Match": {
          "Path": "/vacancy-tasks/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/vacancy-tasks"
          }
        ]
      }
    },
    "Clusters": {
      "recruitmentCluster": {
        "Destinations": {
          "vacancyDestination": {
            "Address": "http://crm-recruitment-api/"
          }
        }
      },
      "candidatesCluster": {
        "Destinations": {
          "candidatesDestination": {
            "Address": "http://candidates-api/"
          }
        }
      },
      "vacancyTasksCluster": {
        "Destinations": {
          "vacancyTasksDestination": {
            "Address": "http://vacancyTasks-api/"
          }
        }
      }
    }
  }
}
