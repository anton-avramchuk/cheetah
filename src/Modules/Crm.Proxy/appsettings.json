{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Yarp": {
    "Routes": {
      "recruitmentRoute": {
        "ClusterId": "recruitmentCluster",
        "Match": {
          "Path": "/recruitment/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/recruitment"
          }
        ]
      }
    },
    "Clusters": {
      "recruitmentCluster": {
        "Destinations": {
          "vacancyDestination": {
            "Address": "http://crm-recruitment-api/"
          }
        }
      }
    }
  }
}
