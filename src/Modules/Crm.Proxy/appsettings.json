{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Yarp": {
    "Routes": {
      "identityRoute": {
        "ClusterId": "identityCluster",
        "Order": 1,
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "masterdataRoute": {
        "ClusterId": "masterdataCluster",
        "Order": 2,
        "Match": {
          "Path": "/api/dictionary/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "identityCluster": {
        "Destinations": {
          "identityDestination": {
            "Address": "http://crm-identity-api"
          }
        }
      },
      "masterdataCluster": {
        "Destinations": {
          "masterdataDestination": {
            "Address": "http://crm-masterdata-api"
          }
        }
      }
    }
  }
}
