@namespace Crm.Identity.Frontend.Components

@using Crm.Identity.Frontend.Models
@using Crm.Identity.ApiClient
@using Cheetah.Blazor.Components
@using Cheetah.Blazor.Components.Dialogs
@using Cheetah.Blazor.Components.Feedback
@using Cheetah.Blazor.Components.Forms
@using Microsoft.AspNetCore.Components.Forms

@implements IDialogForm<UserFormModel>

@if (_isLoading)
{
    <div class="text-center py-4">
        <CrmLoadingSpinner Message="Loading..."/>
    </div>
}
else
{
    <EditForm Model="_model">
        <DataAnnotationsValidator/>

        <CrmTextInput TValue="string"
                      @bind-Value="_model.UserName"
                      Label="Username"
                      Placeholder="Enter username"
                      Required="true"
                      ValidationFor="() => _model.UserName"/>

        <CrmTextInput TValue="string"
                      @bind-Value="_model.Email"
                      Label="Email"
                      Placeholder="Enter email"
                      Required="true"
                      ValidationFor="() => _model.Email"/>

        @if (!_model.IsEdit)
        {
            <CrmTextInput TValue="string"
                          @bind-Value="_model.Password"
                          Label="Password"
                          Placeholder="Enter password"
                          Type="password"
                          Required="true"
                          ValidationFor="() => _model.Password"/>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <CrmAlert Variant="ColorVariant.Danger" Message="@_errorMessage"/>
        }
    </EditForm>
}

@code {
    [CascadingParameter] public IDialogFormContext? DialogContext { get; set; }

    [Parameter]
    public Guid? Id { get; set; }

    [Inject] private IUsersService Service { get; set; } = null!;

    private UserFormModel _model = new();
    private EditContext? _editContext;
    private bool _isLoading;
    private string? _errorMessage;

    public EditContext? EditContext => _editContext;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            _isLoading = true;
            try
            {
                var entity = await Service.GetByIdAsync(Id.Value);
                if (entity != null)
                {
                    _model = new UserFormModel
                    {
                        Id = entity.Id,
                        UserName = entity.UserName,
                        Email = entity.Email
                    };
                }
                else
                {
                    _errorMessage = "Entity not found";
                }
            }
            catch (Exception ex)
            {
                _errorMessage = $"Load error: {ex.Message}";
            }
            finally
            {
                _isLoading = false;
            }
        }

        _editContext = new EditContext(_model);
        DialogContext?.RegisterEditContext(_editContext);
    }

    public Task<DialogFormResult<UserFormModel>> SubmitAsync()
    {
        if (_editContext == null || !_editContext.Validate())
        {
            return Task.FromResult(DialogFormResult<UserFormModel>.Fail("Please fix validation errors"));
        }

        return Task.FromResult(DialogFormResult<UserFormModel>.Ok(_model));
    }
}
