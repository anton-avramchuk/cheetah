@namespace Crm.Identity.Frontend.Components

@using Crm.Identity.Frontend.Models
@using Crm.Identity.ApiClient
@using Cheetah.Blazor.Components
@using Cheetah.Blazor.Components.Dialogs
@using Cheetah.Blazor.Components.Feedback
@using Cheetah.Blazor.Components.Forms
@using Microsoft.AspNetCore.Components.Forms

@implements IDialogForm<RoleFormModel>

@if (_isLoading)
{
    <div class="text-center py-4">
        <CrmLoadingSpinner Message="Loading..."/>
    </div>
}
else
{
    <EditForm Model="_model">
        <DataAnnotationsValidator/>

        <CrmTextInput TValue="string"
                      @bind-Value="_model.Name"
                      Label="Name"
                      Placeholder="Enter name"
                      Required="true"
                      ValidationFor="() => _model.Name"/>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <CrmAlert Variant="ColorVariant.Danger" Message="@_errorMessage"/>
        }
    </EditForm>
}

@code {
    [CascadingParameter] public IDialogFormContext? DialogContext { get; set; }

    [Parameter]
    public Guid? Id { get; set; }

    [Inject] private IRolesService Service { get; set; } = null!;

    private RoleFormModel _model = new();
    private EditContext? _editContext;
    private bool _isLoading;
    private string? _errorMessage;

    public EditContext? EditContext => _editContext;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            _isLoading = true;
            try
            {
                var entity = await Service.GetByIdAsync(Id.Value);
                if (entity != null)
                {
                    _model = new RoleFormModel
                    {
                        Id = entity.Id,
                        Name = entity.Name
                    };
                }
                else
                {
                    _errorMessage = "Entity not found";
                }
            }
            catch (Exception ex)
            {
                _errorMessage = $"Load error: {ex.Message}";
            }
            finally
            {
                _isLoading = false;
            }
        }

        _editContext = new EditContext(_model);
        DialogContext?.RegisterEditContext(_editContext);
    }

    public Task<DialogFormResult<RoleFormModel>> SubmitAsync()
    {
        if (_editContext == null || !_editContext.Validate())
        {
            return Task.FromResult(DialogFormResult<RoleFormModel>.Fail("Please fix validation errors"));
        }

        return Task.FromResult(DialogFormResult<RoleFormModel>.Ok(_model));
    }
}
