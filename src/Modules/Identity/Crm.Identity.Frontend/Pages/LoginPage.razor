@page "/login"
@attribute [AllowAnonymous]
@using System.Net.Http
@layout CrmCenterLayout
@namespace Crm.Identity.Frontend.Pages

@inject IAuthService AuthService
@inject IAuthStateNotifier AuthStateNotifier
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<div style="width: 100%; max-width: 400px;">
    <CrmCard>
        <Header>
            <div class="text-center">
                <h5 class="mb-0">Sign In</h5>
            </div>
        </Header>
        <ChildContent>
            @if (_isLoading)
            {
                <div class="text-center py-4">
                    <CrmLoadingSpinner Message="Signing in..."/>
                </div>
            }
            else
            {
                <EditForm Model="_model" OnValidSubmit="LoginAsync">
                    <DataAnnotationsValidator/>

                    <CrmTextInput TValue="string"
                                  @bind-Value="_model.UserName"
                                  Label="Username"
                                  Placeholder="Enter username"
                                  Required="true"
                                  ValidationFor="() => _model.UserName"/>

                    <CrmTextInput TValue="string"
                                  @bind-Value="_model.Password"
                                  Label="Password"
                                  Placeholder="Enter password"
                                  InputType="password"
                                  Required="true"
                                  ValidationFor="() => _model.Password"/>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <CrmAlert Variant="ColorVariant.Danger" Message="@_errorMessage" Dismissible="true"/>
                    }

                    <div class="mt-3">
                        <CrmButton Text="Login"
                                   Type="submit"
                                   Disabled="_isLoading"/>
                    </div>
                </EditForm>
            }
        </ChildContent>
    </CrmCard>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private LoginFormModel _model = new();
    private string? _errorMessage;
    private bool _isLoading;

    private async Task LoginAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var request = new LoginRequest(_model.UserName, _model.Password);
            var token = await AuthService.LoginAsync(request);
            await AuthStateNotifier.NotifyLoginAsync(token.AccessToken);
            Navigation.NavigateTo(ReturnUrl is not null ? Uri.UnescapeDataString(ReturnUrl) : "/", forceLoad: true);
        }
        catch (HttpRequestException ex) when (
            ex.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.BadRequest)
        {
            _errorMessage = "Invalid username or password.";
            _isLoading = false;
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Connection error. Please check your network and try again.";
            _isLoading = false;
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
            _isLoading = false;
        }
    }
}
