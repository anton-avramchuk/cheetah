@page "/identity/sampleentities"
@namespace Crm.Identity.Frontend.Pages

@inject ICrudService<UserIdentityGridViewModel, UserIdentityFormModel, UserIdentityFormModel> CrudService

<PageTitle>UserIdentity List</PageTitle>

<CrmCrudGrid TGridViewModel="UserIdentityGridViewModel"
             TCreateViewModel="UserIdentityFormModel"
             TEditViewModel="UserIdentityFormModel"
             Service="CrudService"
             Title="UserIdentity List"
             CreateFormType="typeof(UserIdentityForm)"
             EditFormType="typeof(UserIdentityForm)"
             CreateDialogTitle="New UserIdentity"
             EditDialogTitle="Edit UserIdentity"
             CreateButtonText="Add"
             EmptyMessage="No entities found"
             AllowCreate="true"
             AllowEdit="true"
             AllowDelete="true"/>