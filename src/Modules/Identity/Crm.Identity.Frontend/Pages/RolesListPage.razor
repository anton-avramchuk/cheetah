@page "/admin/roles"
@namespace Crm.Identity.Frontend.Pages

@inject ICrudService<RoleGridViewModel, RoleFormModel, RoleFormModel> CrudService

<PageTitle>Roles</PageTitle>

<CrmCrudGrid TGridViewModel="RoleGridViewModel"
             TCreateViewModel="RoleFormModel"
             TEditViewModel="RoleFormModel"
             Service="CrudService"
             Title="Roles"
             CreateFormType="typeof(RoleForm)"
             EditFormType="typeof(RoleForm)"
             CreateDialogTitle="New Role"
             EditDialogTitle="Edit Role"
             CreateButtonText="Add"
             EmptyMessage="No roles found"
             AllowCreate="true"
             AllowEdit="true"
             AllowDelete="true"/>
