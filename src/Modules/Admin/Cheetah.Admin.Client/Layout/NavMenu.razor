@using Cheetah.Frontend.Navigation.Constants
@using Cheetah.Frontend.Navigation.Models
@using Cheetah.Frontend.Navigation.Services.Abstractions
@inject IMenuProvider MenuProvider

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Cheetah.Admin.Client</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        @if (_menuItems != null)
        {
            @foreach (var item in _menuItems)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@item.Url" Match="@GetNavLinkMatch(item)">
                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <span class="@item.Icon" aria-hidden="true"></span>
                        }
                        @item.Name
                    </NavLink>
                </div>
            }
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private IReadOnlyList<MenuItem>? _menuItems;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        var menu = await MenuProvider.GetMenuAsync(StandardMenus.Main);
        _menuItems = menu?.Items;
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private static NavLinkMatch GetNavLinkMatch(MenuItem item)
    {
        return string.IsNullOrEmpty(item.Url) ? NavLinkMatch.All : NavLinkMatch.Prefix;
    }
}
