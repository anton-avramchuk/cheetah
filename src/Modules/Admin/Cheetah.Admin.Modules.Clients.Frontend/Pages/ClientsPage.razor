@page "/clients"
@namespace Cheetah.Admin.Modules.Clients.Frontend.Pages

@using Cheetah.Admin.Modules.Clients.Api.Client
@using Cheetah.Admin.Modules.Clients.Contracts.Requests
@using Cheetah.Admin.Modules.Clients.Contracts.Response
@using Cheetah.Admin.Modules.Clients.Frontend.Models
@using Cheetah.Blazor.Components.Buttons
@using Cheetah.Blazor.Components.DataGrid
@using Cheetah.Blazor.Components.Feedback
@using Cheetah.Blazor.Components.Forms
@using Cheetah.Blazor.Components.Layout
@using Cheetah.Blazor.Components.Modals

@inject IAdminClientsService ClientsService

<CrmCard>
    <Header>
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Клиенты</h5>
            <CrmButton Text="Добавить" Icon="plus" OnClick="OpenCreateDialog" />
        </div>
    </Header>
    <ChildContent>
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <CrmAlert Variant="CrmAlert.AlertVariant.Danger" Message="@_errorMessage" Dismissible="true" />
        }

        <CrmDataGrid TItem="ClientViewModel"
                     Items="_clients"
                     IsLoading="_isLoading"
                     EmptyMessage="Нет клиентов"
                     LoadingMessage="Загрузка...">
            <Columns>
                <th>Название</th>
                <th>Тенант</th>
                <th style="width: 120px;">Действия</th>
            </Columns>
            <RowTemplate>
                <td>@context.Name</td>
                <td>@(context.Tenant?.Name ?? "—")</td>
                <td>
                    <div class="btn-group btn-group-sm">
                        <CrmButton Icon="pencil"
                                   Variant="CrmButton.ButtonVariant.Secondary"
                                   Size="CrmButton.ButtonSize.Small"
                                   OnClick="() => OpenEditDialogAsync(context.Id)" />
                    </div>
                </td>
            </RowTemplate>
        </CrmDataGrid>
    </ChildContent>
</CrmCard>

<CrmModal @bind-IsVisible="_isDialogVisible"
          Title="@(_formModel.IsEdit ? "Редактирование клиента" : "Новый клиент")"
          Size="CrmModal.ModalSize.Default"
          CloseOnBackdropClick="false">
    <ChildContent>
        @if (_isLoadingForm)
        {
            <div class="text-center py-4">
                <CrmLoadingSpinner Message="Загрузка..." />
            </div>
        }
        else
        {
            <EditForm Model="_formModel" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />

                <CrmTextInput TValue="string"
                              @bind-Value="_formModel.Name"
                              Label="Название"
                              Placeholder="Введите название"
                              Required="true"
                              ValidationFor="() => _formModel.Name" />

                <CrmTextArea @bind-Value="_formModel.Description"
                             Label="Описание"
                             Placeholder="Введите описание"
                             Rows="3"
                             ValidationFor="() => _formModel.Description" />

                @if (!string.IsNullOrEmpty(_saveError))
                {
                    <CrmAlert Variant="CrmAlert.AlertVariant.Danger" Message="@_saveError" />
                }

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <CrmButton Text="Отмена"
                               Variant="CrmButton.ButtonVariant.Secondary"
                               OnClick="CloseDialog" />
                    <CrmButton Text="@(_formModel.IsEdit ? "Сохранить" : "Создать")"
                               Type="submit"
                               IsLoading="_isSaving" />
                </div>
            </EditForm>
        }
    </ChildContent>
</CrmModal>

@code {
    private IReadOnlyList<ClientViewModel>? _clients;
    private bool _isLoading = true;
    private string? _errorMessage;

    private bool _isDialogVisible;
    private ClientFormModel _formModel = new();
    private bool _isSaving;
    private bool _isLoadingForm;
    private string? _saveError;

    protected override async Task OnInitializedAsync()
    {
        await LoadClientsAsync();
    }

    private async Task LoadClientsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _clients = await ClientsService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка загрузки: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateDialog()
    {
        _formModel = new ClientFormModel();
        _saveError = null;
        _isDialogVisible = true;
    }

    private async Task OpenEditDialogAsync(Guid clientId)
    {
        _formModel = new ClientFormModel { Id = clientId };
        _saveError = null;
        _isLoadingForm = true;
        _isDialogVisible = true;

        try
        {
            var client = await ClientsService.GetByIdAsync(clientId);
            if (client is not null)
            {
                _formModel.Name = client.Name;
                _formModel.Description = client.Description ?? string.Empty;
            }
            else
            {
                _saveError = "Клиент не найден";
            }
        }
        catch (Exception ex)
        {
            _saveError = $"Ошибка загрузки: {ex.Message}";
        }
        finally
        {
            _isLoadingForm = false;
        }
    }

    private void CloseDialog()
    {
        _isDialogVisible = false;
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _saveError = null;

        try
        {
            var description = string.IsNullOrWhiteSpace(_formModel.Description) ? null : _formModel.Description;

            if (_formModel.IsEdit)
            {
                var request = new UpdateClientRequest(
                    _formModel.Id!.Value,
                    _formModel.Name,
                    description);
                await ClientsService.UpdateAsync(_formModel.Id!.Value, request);
            }
            else
            {
                var request = new CreateClientRequest(_formModel.Name, description);
                await ClientsService.CreateAsync(request);
            }

            _isDialogVisible = false;
            await LoadClientsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _saveError = $"Ошибка сохранения: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
