@page "/clients"
@namespace Cheetah.Admin.Modules.Clients.Frontend.Pages

@inject ICrudService<ClientGridViewModel, ClientFormModel, ClientFormModel> CrudService

<CrmCrudGrid TGridViewModel="ClientGridViewModel"
             TCreateViewModel="ClientFormModel"
             TEditViewModel="ClientFormModel"
             Service="CrudService"
             Title="Клиенты"
             CreateFormType="typeof(ClientForm)"
             EditFormType="typeof(ClientForm)"
             CreateDialogTitle="Новый клиент"
             EditDialogTitle="Редактирование клиента"
             CreateButtonText="Добавить"
             EmptyMessage="Нет клиентов"
             AllowCreate="true"
             AllowEdit="true"
             AllowDelete="false" />
