@page "/dictionary/tariffs"
@namespace Cheetah.Admin.Modules.Clients.Frontend.Pages

@inject ICrudService<TariffGridViewModel, TariffFormModel, TariffFormModel> CrudService

<PageTitle>Tariffs</PageTitle>

<CrmCrudGrid TGridViewModel="TariffGridViewModel"
             TCreateViewModel="TariffFormModel"
             TEditViewModel="TariffFormModel"
             Service="CrudService"
             Title="Tariffs"
             CreateFormType="typeof(TariffForm)"
             EditFormType="typeof(TariffForm)"
             CreateDialogTitle="New Tariff"
             EditDialogTitle="Edit Tariff"
             CreateButtonText="Add"
             EmptyMessage="No tariffs found"
             AllowCreate="true"
             AllowEdit="true"
             AllowDelete="true"/>
