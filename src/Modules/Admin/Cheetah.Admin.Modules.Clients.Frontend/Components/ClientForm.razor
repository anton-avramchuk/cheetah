@namespace Cheetah.Admin.Modules.Clients.Frontend.Components

@using Cheetah.Admin.Modules.Clients.Frontend.Models
@using Cheetah.Blazor.Components
@using Cheetah.Blazor.Components.Dialogs
@using Cheetah.Blazor.Components.Feedback
@using Cheetah.Blazor.Components.Forms
@using Microsoft.AspNetCore.Components.Forms

@implements IDialogForm<ClientFormModel>

@if (_isLoading)
{
    <div class="text-center py-4">
        <CrmLoadingSpinner Message="Загрузка..." />
    </div>
}
else
{
    <EditForm Model="_model" @ref="_editFormRef">
        <DataAnnotationsValidator />

        <CrmTextInput TValue="string"
                      @bind-Value="_model.Name"
                      Label="Название"
                      Placeholder="Введите название"
                      Required="true"
                      ValidationFor="() => _model.Name" />

        <CrmTextArea @bind-Value="_model.Description"
                     Label="Описание"
                     Placeholder="Введите описание"
                     Rows="3"
                     ValidationFor="() => _model.Description" />

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <CrmAlert Variant="ColorVariant.Danger" Message="@_errorMessage" />
        }
    </EditForm>
}

@code {
    [CascadingParameter]
    public IDialogFormContext? DialogContext { get; set; }

    /// <summary>
    /// Client ID for edit mode. If null, creates new client.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    [Inject]
    private IAdminClientsService ClientsService { get; set; } = null!;

    private ClientFormModel _model = new();
    private EditForm? _editFormRef;
    private EditContext? _editContext;
    private bool _isLoading;
    private string? _errorMessage;

    public EditContext? EditContext => _editContext;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            _isLoading = true;
            try
            {
                var client = await ClientsService.GetByIdAsync(Id.Value);
                if (client != null)
                {
                    _model = new ClientFormModel
                    {
                        Id = client.Id,
                        Name = client.Name,
                        Description = client.Description ?? ""
                    };
                }
                else
                {
                    _errorMessage = "Клиент не найден";
                }
            }
            catch (Exception ex)
            {
                _errorMessage = $"Ошибка загрузки: {ex.Message}";
            }
            finally
            {
                _isLoading = false;
            }
        }

        _editContext = new EditContext(_model);
        DialogContext?.RegisterEditContext(_editContext);
    }

    public Task<DialogFormResult<ClientFormModel>> SubmitAsync()
    {
        if (_editContext == null || !_editContext.Validate())
        {
            return Task.FromResult(DialogFormResult<ClientFormModel>.Fail("Исправьте ошибки валидации"));
        }

        return Task.FromResult(DialogFormResult<ClientFormModel>.Ok(_model));
    }
}
