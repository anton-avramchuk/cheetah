@namespace Cheetah.Modules.SalesDocuments.Blazor.Components
@typeparam TGridViewModel where TGridViewModel : class, IHasId
@typeparam TDetailsViewModel where TDetailsViewModel : class, new()
@typeparam TCreateViewModel where TCreateViewModel : class, new()
@using Cheetah.Contracts.Requests

@*
    Generic-шаблон грида документов продаж (КП/заказы/счета). SalesDocuments абстрактен (наследник
    SalesDocumentBase), конкретного типа в модуле нет — приложение объявляет ViewModel'и и формы,
    реализует ICrudService<...> и размещает компонент на странице:

        @@page "/sales-documents"
        <DocumentGrid TGridViewModel="AppDocGridVm" TDetailsViewModel="AppDocDetailsVm"
                      TCreateViewModel="AppDocCreateVm" Service="Service"
                      EditFormType="typeof(AppDocEditForm)" CreateFormType="typeof(AppDocCreateForm)" />
*@

<CrmGrid TGridViewModel="TGridViewModel"
         TDetailsViewModel="TDetailsViewModel"
         TCreateViewModel="TCreateViewModel"
         Service="Service"
         Title="@Title"
         PageSize="PageSize"
         EditFormType="EditFormType"
         CreateFormType="CreateFormType"
         Sortable="Sortable"
         DefaultFilter="DefaultFilter"
         RowActions="RowActions"
         ToolbarActions="ToolbarActions"
         CreateModelFactory="CreateModelFactory"
         AutoOpenCreate="AutoOpenCreate"
         DialogWidthPx="DialogWidthPx"
         ShowCreate="ShowCreate"
         ShowEdit="ShowEdit"
         ShowDelete="ShowDelete"
         CreateButtonLabel="@CreateButtonLabel"
         CreateDialogTitle="@CreateDialogTitle"
         EditDialogTitle="@EditDialogTitle"
         CreateUrl="@CreateUrl"
         EditUrl="EditUrl"
         OnCreated="OnCreated"
         OnUpdated="OnUpdated"
         OnDeleted="OnDeleted"
         OnRowClick="OnRowClick" />

@code {
    [Parameter, EditorRequired]
    public ICrudService<TGridViewModel, TDetailsViewModel, TCreateViewModel> Service { get; set; } = null!;

    [Parameter] public Type?  EditFormType   { get; set; }
    [Parameter] public Type?  CreateFormType { get; set; }
    [Parameter] public string Title          { get; set; } = "Документы";
    [Parameter] public int    PageSize       { get; set; } = 20;

    [Parameter] public RenderFragment<TGridViewModel>? RowActions         { get; set; }
    [Parameter] public RenderFragment?                 ToolbarActions     { get; set; }
    [Parameter] public Func<TCreateViewModel>?         CreateModelFactory { get; set; }
    [Parameter] public bool                            AutoOpenCreate     { get; set; }
    [Parameter] public int?                            DialogWidthPx      { get; set; }

    [Parameter] public bool               Sortable      { get; set; } = true;
    [Parameter] public FilterDescriptor?  DefaultFilter { get; set; }

    [Parameter] public bool   ShowCreate        { get; set; } = true;
    [Parameter] public bool   ShowEdit          { get; set; } = true;
    [Parameter] public bool   ShowDelete        { get; set; } = true;
    [Parameter] public string CreateButtonLabel { get; set; } = "Создать";
    [Parameter] public string CreateDialogTitle { get; set; } = "Создать";
    [Parameter] public string EditDialogTitle   { get; set; } = "Редактировать";

    [Parameter] public string?             CreateUrl { get; set; }
    [Parameter] public Func<Guid, string>? EditUrl   { get; set; }

    [Parameter] public EventCallback<Guid>           OnCreated  { get; set; }
    [Parameter] public EventCallback<Guid>           OnUpdated  { get; set; }
    [Parameter] public EventCallback<Guid>           OnDeleted  { get; set; }
    [Parameter] public EventCallback<TGridViewModel> OnRowClick { get; set; }
}
