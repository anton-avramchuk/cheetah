@using Cheetah.Tenants.Shared.ViewModels

<div class="tenants-list">
    <h3>Tenants</h3>

    @if (Tenants == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (!Tenants.Any())
    {
        <p><em>No tenants found.</em></p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Subdomain</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tenant in Tenants)
                {
                    <tr>
                        <td>@tenant.Name</td>
                        <td>@(tenant.Subdomain ?? "N/A")</td>
                        <td>
                            <span class="badge @(tenant.IsActive ? "bg-success" : "bg-secondary")">
                                @(tenant.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>@tenant.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (tenant.IsActive)
                            {
                                <button class="btn btn-sm btn-warning" @onclick="() => OnDeactivate.InvokeAsync(tenant.Id)">
                                    Deactivate
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-success" @onclick="() => OnActivate.InvokeAsync(tenant.Id)">
                                    Activate
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<TenantViewModel>? Tenants { get; set; }

    [Parameter]
    public EventCallback<Guid> OnActivate { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDeactivate { get; set; }
}
