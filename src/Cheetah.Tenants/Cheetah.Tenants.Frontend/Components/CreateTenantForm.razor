@using Cheetah.Tenants.Shared.Requests

<div class="create-tenant-form">
    <h3>Create New Tenant</h3>

    <EditForm Model="@Request" OnValidSubmit="@HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="name" class="form-label">Tenant Name:</label>
            <InputText id="name" class="form-control" @bind-Value="Request.Name" />
        </div>

        <div class="mb-3">
            <label for="subdomain" class="form-label">Subdomain (optional):</label>
            <InputText id="subdomain" class="form-control" @bind-Value="Request.Subdomain" />
        </div>

        <button type="submit" class="btn btn-primary">Create Tenant</button>
    </EditForm>
</div>

@code {
    [Parameter]
    public EventCallback<CreateTenantRequest> OnSubmit { get; set; }

    private CreateTenantRequest Request { get; set; } = new();

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync(Request);
        Request = new CreateTenantRequest();
    }
}
