@inject NavigationManager Navigation

<CrmCard>
    <Header>
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h5 class="mb-0">@Tenant.Name</h5>
                @if (!string.IsNullOrEmpty(Tenant.Subdomain))
                {
                    <small class="text-muted">
                        <i class="bi bi-globe"></i> @Tenant.Subdomain
                    </small>
                }
            </div>
            <div>
                <CrmBadge Text="@(Tenant.IsActive ? "Active" : "Inactive")"
                          Variant="@(Tenant.IsActive ? CrmBadge.BadgeVariant.Success : CrmBadge.BadgeVariant.Secondary)" />
            </div>
        </div>
    </Header>

    <ChildContent>
        @if (Tenant.CreatedAt.HasValue)
        {
            <p class="card-text">
                <small class="text-muted">
                    <i class="bi bi-calendar"></i> Created: @Tenant.CreatedAt.Value.ToString("yyyy-MM-dd")
                </small>
            </p>
        }

        @if (ShowActions)
        {
            <div class="d-flex gap-2 mt-3">
                <CrmButton Text="View"
                           Icon="eye"
                           Size="CrmButton.ButtonSize.Small"
                           Variant="CrmButton.ButtonVariant.Primary"
                           OnClick="@ViewDetails" />
                <CrmButton Text="Edit"
                           Icon="pencil"
                           Size="CrmButton.ButtonSize.Small"
                           Variant="CrmButton.ButtonVariant.Warning"
                           Outline="true"
                           OnClick="@Edit" />
            </div>
        }
    </ChildContent>
</CrmCard>

@code {
    [Parameter, EditorRequired]
    public TenantViewModel Tenant { get; set; } = null!;

    [Parameter]
    public bool ShowActions { get; set; } = true;

    [Parameter]
    public EventCallback<Guid> OnViewDetails { get; set; }

    [Parameter]
    public EventCallback<Guid> OnEdit { get; set; }

    private async Task ViewDetails()
    {
        if (OnViewDetails.HasDelegate)
        {
            await OnViewDetails.InvokeAsync(Tenant.Id);
        }
        else
        {
            Navigation.NavigateTo($"/tenants/{Tenant.Id}");
        }
    }

    private async Task Edit()
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync(Tenant.Id);
        }
        else
        {
            Navigation.NavigateTo($"/tenants/{Tenant.Id}/edit");
        }
    }
}
