@page "/tenants/{TenantId:guid}"
@using Cheetah.Blazor.Components.Buttons
@using Cheetah.Blazor.Components.Layout
@inject ITenantApiClient TenantApiClient
@inject NavigationManager Navigation

@if (_isLoading)
{
    <CrmLoadingSpinner Message="Loading tenant details..." />
}
else if (_errorMessage != null)
{
    <CrmAlert Variant="CrmAlert.AlertVariant.Danger"
              Message="@_errorMessage"
              Icon="exclamation-triangle"
              Dismissible="true"
              @bind-IsVisible="@_showError" />
    <CrmButton Text="Back to List"
               Icon="arrow-left"
               Variant="CrmButton.ButtonVariant.Secondary"
               OnClick="@NavigateToList" />
}
else if (_tenant == null)
{
    <CrmAlert Variant="CrmAlert.AlertVariant.Warning"
              Message="Tenant not found."
              Icon="exclamation-triangle" />
    <CrmButton Text="Back to List"
               Icon="arrow-left"
               Variant="CrmButton.ButtonVariant.Secondary"
               OnClick="@NavigateToList" />
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Tenant Details</h3>
        <div>
            <CrmButton Text="Edit"
                       Icon="pencil"
                       Variant="CrmButton.ButtonVariant.Warning"
                       OnClick="@NavigateToEdit" />
            <CrmButton Text="Back to List"
                       Icon="arrow-left"
                       Variant="CrmButton.ButtonVariant.Secondary"
                       OnClick="@NavigateToList" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <CrmCard Title="General Information">
                <ChildContent>
                    <table class="table table-sm">
                        <tbody>
                            <tr>
                                <th style="width: 30%;">ID</th>
                                <td>@_tenant.Id</td>
                            </tr>
                            <tr>
                                <th>Name</th>
                                <td>@_tenant.Name</td>
                            </tr>
                            <tr>
                                <th>Subdomain</th>
                                <td>@(_tenant.Subdomain ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Status</th>
                                <td>
                                    <CrmBadge Text="@(_tenant.IsActive ? "Active" : "Inactive")"
                                              Variant="@(_tenant.IsActive ? CrmBadge.BadgeVariant.Success : CrmBadge.BadgeVariant.Secondary)" />
                                </td>
                            </tr>
                            <tr>
                                <th>Created At</th>
                                <td>@_tenant.CreatedAt?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                            <tr>
                                <th>Updated At</th>
                                <td>@_tenant.UpdatedAt?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        </tbody>
                    </table>
                </ChildContent>

                <Footer>
                    @if (_tenant.IsActive)
                    {
                        <CrmButton Text="Deactivate"
                                   Icon="x-circle"
                                   Variant="CrmButton.ButtonVariant.Secondary"
                                   IsLoading="@_isProcessing"
                                   Disabled="@_isProcessing"
                                   OnClick="@DeactivateTenant" />
                    }
                    else
                    {
                        <CrmButton Text="Activate"
                                   Icon="check-circle"
                                   Variant="CrmButton.ButtonVariant.Success"
                                   IsLoading="@_isProcessing"
                                   Disabled="@_isProcessing"
                                   OnClick="@ActivateTenant" />
                    }
                </Footer>
            </CrmCard>
        </div>

        <div class="col-md-6">
            <CrmCard Title="Connection Strings">
                <ChildContent>
                    @if (_tenant.ConnectionStrings != null && _tenant.ConnectionStrings.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Default</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cs in _tenant.ConnectionStrings)
                                {
                                    <tr>
                                        <td>@cs.Name</td>
                                        <td>
                                            @if (cs.IsDefault)
                                            {
                                                <i class="bi bi-check-circle text-success"></i>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No connection strings configured.</p>
                    }
                </ChildContent>
            </CrmCard>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid TenantId { get; set; }

    private TenantViewModel? _tenant;
    private bool _isLoading = true;
    private bool _isProcessing = false;
    private bool _showError = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantAsync();
    }

    private async Task LoadTenantAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _tenant = await TenantApiClient.GetByIdAsync(TenantId);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load tenant: {ex.Message}";
            _showError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ActivateTenant()
    {
        _isProcessing = true;
        _errorMessage = null;

        try
        {
            await TenantApiClient.ActivateAsync(TenantId);
            await LoadTenantAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to activate tenant: {ex.Message}";
            _showError = true;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task DeactivateTenant()
    {
        _isProcessing = true;
        _errorMessage = null;

        try
        {
            await TenantApiClient.DeactivateAsync(TenantId);
            await LoadTenantAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to deactivate tenant: {ex.Message}";
            _showError = true;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void NavigateToEdit()
    {
        Navigation.NavigateTo($"/tenants/{TenantId}/edit");
    }

    private void NavigateToList()
    {
        Navigation.NavigateTo("/tenants");
    }
}
