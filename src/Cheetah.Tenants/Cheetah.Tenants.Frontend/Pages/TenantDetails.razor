@page "/tenants/{TenantId:guid}"
@inject ITenantApiClient TenantApiClient
@inject NavigationManager Navigation

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @errorMessage
    </div>
    <button class="btn btn-secondary" @onclick="NavigateToList">
        <i class="bi bi-arrow-left"></i> Back to List
    </button>
}
else if (tenant == null)
{
    <div class="alert alert-warning" role="alert">
        Tenant not found.
    </div>
    <button class="btn btn-secondary" @onclick="NavigateToList">
        <i class="bi bi-arrow-left"></i> Back to List
    </button>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Tenant Details</h3>
        <div>
            <button class="btn btn-warning" @onclick="NavigateToEdit">
                <i class="bi bi-pencil"></i> Edit
            </button>
            <button class="btn btn-secondary" @onclick="NavigateToList">
                <i class="bi bi-arrow-left"></i> Back to List
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <h5>General Information</h5>
                    <table class="table table-sm">
                        <tbody>
                            <tr>
                                <th style="width: 30%;">ID</th>
                                <td>@tenant.Id</td>
                            </tr>
                            <tr>
                                <th>Name</th>
                                <td>@tenant.Name</td>
                            </tr>
                            <tr>
                                <th>Subdomain</th>
                                <td>@(tenant.Subdomain ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Status</th>
                                <td>
                                    @if (tenant.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Created At</th>
                                <td>@tenant.CreatedAt?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                            <tr>
                                <th>Updated At</th>
                                <td>@tenant.UpdatedAt?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="mt-3">
                        @if (tenant.IsActive)
                        {
                            <button class="btn btn-secondary" @onclick="DeactivateTenant" disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle"></i>
                                }
                                <span> Deactivate</span>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-success" @onclick="ActivateTenant" disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle"></i>
                                }
                                <span> Activate</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <h5>Connection Strings</h5>
                    @if (tenant.ConnectionStrings != null && tenant.ConnectionStrings.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Default</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cs in tenant.ConnectionStrings)
                                {
                                    <tr>
                                        <td>@cs.Name</td>
                                        <td>
                                            @if (cs.IsDefault)
                                            {
                                                <i class="bi bi-check-circle text-success"></i>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No connection strings configured.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid TenantId { get; set; }

    private TenantViewModel? tenant;
    private bool isLoading = true;
    private bool isProcessing = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantAsync();
    }

    private async Task LoadTenantAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            tenant = await TenantApiClient.GetByIdAsync(TenantId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load tenant: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ActivateTenant()
    {
        isProcessing = true;
        errorMessage = null;

        try
        {
            await TenantApiClient.ActivateAsync(TenantId);
            await LoadTenantAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to activate tenant: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task DeactivateTenant()
    {
        isProcessing = true;
        errorMessage = null;

        try
        {
            await TenantApiClient.DeactivateAsync(TenantId);
            await LoadTenantAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to deactivate tenant: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void NavigateToEdit()
    {
        Navigation.NavigateTo($"/tenants/{TenantId}/edit");
    }

    private void NavigateToList()
    {
        Navigation.NavigateTo("/tenants");
    }
}
