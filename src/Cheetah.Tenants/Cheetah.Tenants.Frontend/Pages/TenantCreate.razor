@page "/tenants/create"
@using Cheetah.Blazor.Components.Buttons
@using Cheetah.Blazor.Components.Forms
@inject ITenantApiClient TenantApiClient
@inject NavigationManager Navigation

<h3>Create New Tenant</h3>

<div class="row">
    <div class="col-md-8">
        <EditForm Model="@request" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (errorMessage != null)
            {
                <CrmAlert Variant="CrmAlert.AlertVariant.Danger"
                          Message="@errorMessage"
                          Icon="exclamation-triangle"
                          Dismissible="true"
                          @bind-IsVisible="@showError" />
            }

            <CrmTextInput @bind-Value="request.Name"
                          Label="Tenant Name"
                          Placeholder="Enter tenant name"
                          Required="true"
                          HelpText="The name will be used to identify this tenant."
                          ValidationFor="@(() => request.Name)" />

            <CrmTextInput @bind-Value="request.Subdomain"
                          Label="Subdomain"
                          Placeholder="Enter subdomain (optional)"
                          HelpText="The subdomain will be used for tenant-specific URLs (e.g., subdomain.yourapp.com)"
                          ValidationFor="@(() => request.Subdomain)" />

            <div class="mb-3">
                <CrmButton Text="Create Tenant"
                           Icon="check-circle"
                           Type="submit"
                           Variant="CrmButton.ButtonVariant.Primary"
                           IsLoading="@isSubmitting"
                           Disabled="@isSubmitting" />
                <CrmButton Text="Cancel"
                           Icon="x-circle"
                           Variant="CrmButton.ButtonVariant.Secondary"
                           Disabled="@isSubmitting"
                           OnClick="@Cancel" />
            </div>
        </EditForm>
    </div>
</div>

@code {
    private CreateTenantRequest request = new() { Name = string.Empty };
    private bool isSubmitting = false;
    private bool showError = true;
    private string? errorMessage;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var tenantId = await TenantApiClient.CreateAsync(request);
            Navigation.NavigateTo($"/tenants/{tenantId}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create tenant: {ex.Message}";
            showError = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/tenants");
    }
}
