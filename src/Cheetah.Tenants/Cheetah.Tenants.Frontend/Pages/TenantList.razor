@page "/tenants"
@inject ITenantApiClient TenantApiClient
@inject NavigationManager Navigation

<h3>Tenants</h3>

<div class="mb-3">
    <CrmButton Text="Create New Tenant"
               Icon="plus-circle"
               Variant="CrmButton.ButtonVariant.Primary"
               OnClick="@NavigateToCreate" />
</div>

<CrmDataGrid Items="@_tenants"
             IsLoading="@_isLoading"
             ErrorMessage="@_errorMessage"
             EmptyMessage="No tenants found. Click 'Create New Tenant' to add one.">
    <Columns>
        <th>Name</th>
        <th>Subdomain</th>
        <th>Status</th>
        <th>Created</th>
        <th>Actions</th>
    </Columns>
    <RowTemplate Context="tenant">
        <td>@tenant.Name</td>
        <td>@(tenant.Subdomain ?? "-")</td>
        <td>
            <CrmBadge Text="@(tenant.IsActive ? "Active" : "Inactive")"
                      Variant="@(tenant.IsActive ? CrmBadge.BadgeVariant.Success : CrmBadge.BadgeVariant.Secondary)" />
        </td>
        <td>@tenant.CreatedAt?.ToString("yyyy-MM-dd")</td>
        <td>
            <CrmButton Text="Details"
                       Icon="eye"
                       Size="CrmButton.ButtonSize.Small"
                       Variant="CrmButton.ButtonVariant.Info"
                       OnClick="@(() => NavigateToDetails(tenant.Id))" />
            <CrmButton Text="Edit"
                       Icon="pencil"
                       Size="CrmButton.ButtonSize.Small"
                       Variant="CrmButton.ButtonVariant.Warning"
                       OnClick="@(() => NavigateToEdit(tenant.Id))" />
            @if (tenant.IsActive)
            {
                <CrmButton Text="Deactivate"
                           Icon="x-circle"
                           Size="CrmButton.ButtonSize.Small"
                           Variant="CrmButton.ButtonVariant.Secondary"
                           Disabled="@_isProcessing"
                           OnClick="@(() => DeactivateTenant(tenant.Id))" />
            }
            else
            {
                <CrmButton Text="Activate"
                           Icon="check-circle"
                           Size="CrmButton.ButtonSize.Small"
                           Variant="CrmButton.ButtonVariant.Success"
                           Disabled="@_isProcessing"
                           OnClick="@(() => ActivateTenant(tenant.Id))" />
            }
        </td>
    </RowTemplate>
</CrmDataGrid>

@code {
    private List<TenantViewModel>? _tenants;
    private bool _isLoading = true;
    private bool _isProcessing;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantsAsync();
    }

    private async Task LoadTenantsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _tenants = await TenantApiClient.GetAllAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load tenants: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ActivateTenant(Guid tenantId)
    {
        _isProcessing = true;

        try
        {
            await TenantApiClient.ActivateAsync(tenantId);
            await LoadTenantsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to activate tenant: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task DeactivateTenant(Guid tenantId)
    {
        _isProcessing = true;

        try
        {
            await TenantApiClient.DeactivateAsync(tenantId);
            await LoadTenantsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to deactivate tenant: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/tenants/create");
    }

    private void NavigateToDetails(Guid tenantId)
    {
        Navigation.NavigateTo($"/tenants/{tenantId}");
    }

    private void NavigateToEdit(Guid tenantId)
    {
        Navigation.NavigateTo($"/tenants/{tenantId}/edit");
    }
}
