@page "/tenants"
@inject ITenantApiClient TenantApiClient
@inject NavigationManager Navigation

<h3>Tenants</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="NavigateToCreate">
        <i class="bi bi-plus-circle"></i> Create New Tenant
    </button>
</div>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @errorMessage
    </div>
}
else if (tenants == null || !tenants.Any())
{
    <div class="alert alert-info" role="alert">
        No tenants found. Click "Create New Tenant" to add one.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Subdomain</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tenant in tenants)
                {
                    <tr>
                        <td>@tenant.Name</td>
                        <td>@(tenant.Subdomain ?? "-")</td>
                        <td>
                            @if (tenant.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>@tenant.CreatedAt?.ToString("yyyy-MM-dd")</td>
                        <td>
                            <button class="btn btn-sm btn-info" @onclick="() => NavigateToDetails(tenant.Id)">
                                <i class="bi bi-eye"></i> Details
                            </button>
                            <button class="btn btn-sm btn-warning" @onclick="() => NavigateToEdit(tenant.Id)">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            @if (tenant.IsActive)
                            {
                                <button class="btn btn-sm btn-secondary" @onclick="() => DeactivateTenant(tenant.Id)" disabled="@isProcessing">
                                    <i class="bi bi-x-circle"></i> Deactivate
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-success" @onclick="() => ActivateTenant(tenant.Id)" disabled="@isProcessing">
                                    <i class="bi bi-check-circle"></i> Activate
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<TenantViewModel>? tenants;
    private bool isLoading = true;
    private bool isProcessing = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantsAsync();
    }

    private async Task LoadTenantsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            tenants = await TenantApiClient.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load tenants: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ActivateTenant(Guid tenantId)
    {
        isProcessing = true;

        try
        {
            await TenantApiClient.ActivateAsync(tenantId);
            await LoadTenantsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to activate tenant: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task DeactivateTenant(Guid tenantId)
    {
        isProcessing = true;

        try
        {
            await TenantApiClient.DeactivateAsync(tenantId);
            await LoadTenantsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to deactivate tenant: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/tenants/create");
    }

    private void NavigateToDetails(Guid tenantId)
    {
        Navigation.NavigateTo($"/tenants/{tenantId}");
    }

    private void NavigateToEdit(Guid tenantId)
    {
        Navigation.NavigateTo($"/tenants/{tenantId}/edit");
    }
}
