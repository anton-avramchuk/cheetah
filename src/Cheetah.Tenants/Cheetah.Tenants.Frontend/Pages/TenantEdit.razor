@page "/tenants/{TenantId:guid}/edit"
@using Cheetah.Blazor.Components.Buttons
@using Cheetah.Blazor.Components.Forms
@inject ITenantApiClient TenantApiClient
@inject NavigationManager Navigation

<h3>Edit Tenant</h3>

@if (_isLoading)
{
    <CrmLoadingSpinner Message="Loading tenant information..." />
}
else if (_errorMessage != null)
{
    <CrmAlert Variant="CrmAlert.AlertVariant.Danger"
              Message="@_errorMessage"
              Icon="exclamation-triangle"
              Dismissible="true"
              @bind-IsVisible="@_showError" />
    <CrmButton Text="Back"
               Icon="arrow-left"
               Variant="CrmButton.ButtonVariant.Secondary"
               OnClick="@Cancel" />
}
else if (_tenant == null)
{
    <CrmAlert Variant="CrmAlert.AlertVariant.Warning"
              Message="Tenant not found."
              Icon="exclamation-triangle" />
    <CrmButton Text="Back to List"
               Icon="arrow-left"
               Variant="CrmButton.ButtonVariant.Secondary"
               OnClick="@Cancel" />
}
else
{
    <div class="row">
        <div class="col-md-8">
            <CrmAlert Variant="CrmAlert.AlertVariant.Info"
                      Icon="info-circle">
                <strong>Note:</strong> Update functionality will be implemented once the backend Update endpoint is added.
                Currently, you can only view tenant information here.
            </CrmAlert>

            <EditForm Model="@_tenant" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <CrmTextInput @bind-Value="_tenant.Name"
                              Label="Tenant Name"
                              Disabled="true" />

                <CrmTextInput @bind-Value="_tenant.Subdomain"
                              Label="Subdomain"
                              Disabled="true"
                              HelpText="The subdomain cannot be changed after creation." />

                <div class="mb-3">
                    <label class="form-label">Status</label>
                    <div>
                        <CrmBadge Text="@(_tenant.IsActive ? "Active" : "Inactive")"
                                  Variant="@(_tenant.IsActive ? CrmBadge.BadgeVariant.Success : CrmBadge.BadgeVariant.Secondary)" />
                    </div>
                    <div class="form-text">
                        Use Activate/Deactivate buttons on the details page to change status.
                    </div>
                </div>

                <div class="mb-3">
                    <CrmButton Text="Back to Details"
                               Icon="arrow-left"
                               Variant="CrmButton.ButtonVariant.Secondary"
                               OnClick="@Cancel" />
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid TenantId { get; set; }

    private TenantViewModel? _tenant;
    private bool _isLoading = true;
    private bool _showError = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantAsync();
    }

    private async Task LoadTenantAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _tenant = await TenantApiClient.GetByIdAsync(TenantId);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load tenant: {ex.Message}";
            _showError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task HandleSubmit()
    {
        // TODO: Implement update when backend endpoint is ready
        // Will need to create UpdateTenantCommand, UpdateTenantCommandHandler,
        // UpdateTenantRequest, and add PUT /api/tenants/{id} endpoint
        return Task.CompletedTask;
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/tenants/{TenantId}");
    }
}
