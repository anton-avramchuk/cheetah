<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <!-- Linked source files from Cheetah.Contracts -->
        <Compile Include="..\Cheetah.Contracts\Attributes\ApiRouteAttribute.cs">
            <Link>Common\ApiRouteAttribute.cs</Link>
        </Compile>
        <Compile Include="..\Cheetah.Contracts\Attributes\ApiMethod.cs">
            <Link>Common\ApiMethod.cs</Link>
        </Compile>
        <Compile Include="..\Cheetah.Contracts\Attributes\GenerateApiClientAttribute.cs">
            <Link>Common\GenerateApiClientAttribute.cs</Link>
        </Compile>

        <!-- Linked source files from Generators.Core -->
        <Compile Include="..\Cheetah.Generators.Core\IsExternalInit.cs">
            <Link>Common\IsExternalInit.cs</Link>
        </Compile>

        <!-- Linked source files from Core -->
        <Compile Include="..\Cheetah.Core\Modularity\ICrmModule.cs">
            <Link>Common\ICrmModule.cs</Link>
        </Compile>
        <Compile Include="..\Cheetah.Core\Modularity\DependsOnAttribute.cs">
            <Link>Common\DependsOnAttribute.cs</Link>
        </Compile>
        <Compile Include="..\Cheetah.Core\Modularity\IDependedTypesProvider.cs">
            <Link>Common\IDependedTypesProvider.cs</Link>
        </Compile>
        <Compile Include="..\Cheetah.Core\Modularity\ServiceConfigurationContext.cs">
            <Link>Common\ServiceConfigurationContext.cs</Link>
        </Compile>
        <Compile Include="..\Cheetah.Core\Extensions\Collections\DictionaryExtensions.cs">
            <Link>Common\DictionaryExtensions.cs</Link>
        </Compile>

        <!-- Dependency injection -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    </ItemGroup>

</Project>
