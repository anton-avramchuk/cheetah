@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Cheetah.AspNetCore.Blazor.Navigation
@using Cheetah.AspNetCore.Blazor.Navigation.Models
@implements IDisposable
@inject NavigationManager NavigationManager
@inject INavigationMenuService NavigationMenuService
@inject AuthenticationStateProvider AuthProvider
@inject IMenuAccessEvaluator Access
@inject IMenuFeatureEvaluator Features

<nav class="sidebar-nav">
    @foreach (var menuSection in _menu.Sections)
    {
        var visibleItems = menuSection.Items.Where(CanSee).ToList();
        @if (visibleItems.Count > 0)
        {
            <div class="nav-section">
                <div class="nav-section-label">@menuSection.Label</div>
                @foreach (var item in visibleItems)
                {
                    @if (item.IsGroup)
                    {
                        <div class="nav-group @(IsGroupExpanded(item.Id) ? "expanded" : "")">
                            <button class="nav-item nav-group-toggle" @onclick="() => ToggleGroup(item.Id)">
                                @if (item.Icon != null)
                                {
                                    <i class="@item.Icon nav-icon"></i>
                                }
                                <span class="nav-text">@item.Label</span>
                                @if (!string.IsNullOrEmpty(item.Badge))
                                {
                                    <span class="nav-badge">@item.Badge</span>
                                }
                                <i class="bi bi-chevron-down nav-chevron"></i>
                            </button>
                            <div class="nav-group-children">
                                @foreach (var child in item.Children.Where(CanSee))
                                {
                                    <a class="nav-item nav-child @(IsActive(child) ? "active" : null)"
                                       href="@child.Url"
                                       aria-current="@(IsActive(child) ? "page" : null)">
                                        <span class="nav-child-dot"></span>
                                        <span class="nav-text">@child.Label</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <a class="nav-item @(IsActive(item) ? "active" : null)"
                           href="@item.Url"
                           aria-current="@(IsActive(item) ? "page" : null)">
                            @if (item.Icon != null)
                            {
                                <i class="@item.Icon nav-icon"></i>
                            }
                            <span class="nav-text">@item.Label</span>
                            @if (!string.IsNullOrEmpty(item.Badge))
                            {
                                <span class="nav-badge">@item.Badge</span>
                            }
                        </a>
                    }
                }
            </div>
        }
    }
</nav>

@code {
    private Menu _menu = new(string.Empty);
    private HashSet<string> _expandedGroups = new();
    private ClaimsPrincipal _user = new(new ClaimsIdentity());

    // Фичи, выключенные на момент построения меню. Считаются один раз (рендер синхронный).
    private IReadOnlySet<string> _disabledFeatures = new HashSet<string>();

    // Нормализованный URL активного пункта (самое специфичное совпадение для текущего пути).
    private string? _activeUrl;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        _menu = await NavigationMenuService.GetMenuAsync(Constants.MainMenuId);
        _disabledFeatures = await MenuVisibility.CollectDisabledAsync(_menu, Features);
        UpdateActive(NavigationManager.Uri);
        UpdateExpandedGroups(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    // Пункт виден, если у пользователя есть нужное разрешение И включена нужная фича (см. MenuVisibility).
    private bool CanSee(MenuItem item) => MenuVisibility.CanSee(item, _user, Access, _disabledFeatures);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateActive(e.Location);
        UpdateExpandedGroups(e.Location);
        InvokeAsync(StateHasChanged);
    }

    // Активный пункт = самый специфичный (длинный) совпавший URL среди всех ссылок меню.
    private void UpdateActive(string uri)
        => _activeUrl = MenuActiveResolver.Resolve(AllLinkUrls(), NavigationManager.ToBaseRelativePath(uri));

    private IEnumerable<string?> AllLinkUrls()
    {
        foreach (var section in _menu.Sections)
            foreach (var item in section.Items)
            {
                if (item.IsGroup)
                {
                    foreach (var child in item.Children)
                        yield return child.Url;
                }
                else
                {
                    yield return item.Url;
                }
            }
    }

    private bool IsActive(MenuItem item)
        => _activeUrl is not null && MenuActiveResolver.Normalize(item.Url) == _activeUrl;

    private void UpdateExpandedGroups(string uri)
    {
        var rel = NavigationManager.ToBaseRelativePath(uri).ToLower();
        foreach (var menuSection in _menu.Sections)
        {
            foreach (var item in menuSection.Items.Where(i => i.IsGroup))
            {
                if (item.Children.Any(c => rel.StartsWith((c.Url ?? string.Empty).TrimStart('/').ToLower())))
                    _expandedGroups.Add(item.Id);
            }
        }
    }

    private bool IsGroupExpanded(string groupId) => _expandedGroups.Contains(groupId);

    private void ToggleGroup(string groupId)
    {
        if (!_expandedGroups.Remove(groupId))
            _expandedGroups.Add(groupId);
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
