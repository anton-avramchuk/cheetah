@page "/not-found"
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager NavigationManager

<div class="not-found-container">
    <div class="not-found-content">
        <div class="error-code">404</div>
        <h1 class="error-title">Страница не найдена</h1>
        <p class="error-message">Кажется, вы заблудились. Страница, которую вы ищете, была удалена, переименована или никогда не существовала.</p>
        <button class="back-btn" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> На главную
        </button>
    </div>
    
    <div class="not-found-illustration">
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <path fill="#3b82f6" d="M45.7,-76.1C58.9,-69.3,69.1,-55.3,77.5,-41.2C85.9,-27.1,92.5,-13.6,90.3,-1.3C88.1,11,77.1,22,68.2,33.5C59.3,45,52.5,57.1,41.9,64.2C31.3,71.3,16.9,73.4,2.5,69.2C-11.9,65,-23.8,54.5,-35.1,46.1C-46.4,37.7,-57.1,31.4,-65.7,21.5C-74.3,11.6,-80.8,-1.9,-78.9,-14.2C-77,-26.5,-66.7,-37.6,-55.4,-45.3C-44.1,-53,-31.8,-57.3,-20,-63.3C-8.2,-69.3,3.1,-77,16.5,-78.8C29.9,-80.6,43.3,-76.5,45.7,-76.1Z" transform="translate(100 100)" />
            <circle cx="100" cy="100" r="30" fill="none" stroke="#ffffff" stroke-width="6" />
            <line x1="120" y1="120" x2="140" y2="140" stroke="#ffffff" stroke-width="8" stroke-linecap="round" />
            <circle cx="100" cy="90" r="8" fill="#ffffff" />
            <path d="M 85 110 C 85 95, 115 95, 115 110" fill="#ffffff" />
        </svg>
    </div>
</div>

@code {
    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }
}
