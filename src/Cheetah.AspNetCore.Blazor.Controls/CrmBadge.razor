@namespace Cheetah.AspNetCore.Blazor.Controls

<div class="@(string.IsNullOrEmpty(Label) ? "d-inline-block" : "mb-3")">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label d-block">@Label</label>
    }
    <span class="badge @VariantClass @Class">@ChildContent</span>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Label   { get; set; } = string.Empty;
    [Parameter] public string Variant { get; set; } = "primary";
    [Parameter] public string Class   { get; set; } = string.Empty;
    [Parameter] public bool   Pill    { get; set; }

    private string VariantClass => $"text-bg-{Variant}{(Pill ? " rounded-pill" : "")}";
}
