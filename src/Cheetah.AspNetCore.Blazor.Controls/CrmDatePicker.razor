@namespace Cheetah.AspNetCore.Blazor.Controls

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label @(Required ? "crm-label-required" : "")">@Label</label>
    }
    <input type="date"
           class="form-control @(HasError ? "is-invalid" : "") @Class"
           value="@FormatValue()"
           disabled="@Disabled"
           readonly="@ReadOnly"
           min="@Min"
           max="@Max"
           @onchange="OnChange" />
    @if (HasError)
    {
        <div class="invalid-feedback">@Error</div>
    }
    @if (!string.IsNullOrEmpty(Hint) && !HasError)
    {
        <div class="form-text">@Hint</div>
    }
</div>

@code {
    [Parameter] public DateOnly? Value    { get; set; }
    [Parameter] public string  Label      { get; set; } = string.Empty;
    [Parameter] public string? Error      { get; set; }
    [Parameter] public string  Hint       { get; set; } = string.Empty;
    [Parameter] public string  Class      { get; set; } = string.Empty;
    [Parameter] public bool    Disabled   { get; set; }
    [Parameter] public bool    ReadOnly   { get; set; }
    [Parameter] public bool    Required   { get; set; }
    [Parameter] public string? Min        { get; set; }
    [Parameter] public string? Max        { get; set; }
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);

    private string FormatValue() => Value?.ToString("yyyy-MM-dd") ?? string.Empty;

    private Task OnChange(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
            return ValueChanged.InvokeAsync(d);
        return ValueChanged.InvokeAsync(null);
    }
}
