@namespace Cheetah.AspNetCore.Blazor.Controls

<div class="mb-3">
    <div class="form-check form-switch">
        <input type="checkbox"
               class="form-check-input @Class"
               role="switch"
               id="@_id"
               checked="@Value"
               disabled="@Disabled"
               @onchange="OnChange" />
        @if (!string.IsNullOrEmpty(Label))
        {
            <label class="form-check-label" for="@_id">@Label</label>
        }
    </div>
    @if (!string.IsNullOrEmpty(Hint))
    {
        <div class="form-text">@Hint</div>
    }
</div>

@code {
    [Parameter] public bool   Value    { get; set; }
    [Parameter] public string Label    { get; set; } = string.Empty;
    [Parameter] public string Hint     { get; set; } = string.Empty;
    [Parameter] public string Class    { get; set; } = string.Empty;
    [Parameter] public bool   Disabled { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    private readonly string _id = $"sw-{Guid.NewGuid():N}";

    private Task OnChange(ChangeEventArgs e)
        => ValueChanged.InvokeAsync(e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var r) && r);
}
