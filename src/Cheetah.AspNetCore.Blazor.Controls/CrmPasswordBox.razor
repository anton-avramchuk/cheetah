@namespace Cheetah.AspNetCore.Blazor.Controls
@implements IDisposable

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label @(Required ? "crm-label-required" : "")">@Label</label>
    }
    <div class="input-group">
        <input type="@(_show ? "text" : "password")"
               class="form-control @(HasError ? "is-invalid" : "") @Class"
               value="@Value"
               placeholder="@Placeholder"
               disabled="@Disabled"
               autocomplete="@AutoComplete"
               @oninput="OnInput" />
        <button type="button" class="btn btn-outline-secondary" @onclick="Toggle" tabindex="-1">
            @if (_show)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                    <line x1="1" y1="1" x2="23" y2="23"/>
                </svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                </svg>
            }
        </button>
        @if (HasError)
        {
            <div class="invalid-feedback">@Error</div>
        }
    </div>
    @if (!string.IsNullOrEmpty(Hint) && !HasError)
    {
        <div class="form-text">@Hint</div>
    }
</div>

@code {
    [CascadingParameter] public DialogFormContext? FormContext { get; set; }

    [Parameter] public string? Value        { get; set; }
    [Parameter] public string  Label        { get; set; } = string.Empty;
    [Parameter] public string  Placeholder  { get; set; } = string.Empty;
    [Parameter] public string? Error        { get; set; }
    [Parameter] public string  Hint         { get; set; } = string.Empty;
    [Parameter] public string  Class        { get; set; } = string.Empty;
    [Parameter] public string  AutoComplete { get; set; } = "current-password";
    [Parameter] public bool    Disabled     { get; set; }
    [Parameter] public bool    Required     { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);
    private bool _show;
    private readonly string _fieldId = Guid.NewGuid().ToString("N");

    private void Toggle() => _show = !_show;

    protected override void OnInitialized()
    {
        if (Required && FormContext is not null)
            FormContext.SetField(_fieldId, !string.IsNullOrWhiteSpace(Value));
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (Required && FormContext is not null)
            FormContext.SetField(_fieldId, !string.IsNullOrWhiteSpace(value));
        await ValueChanged.InvokeAsync(value);
    }

    public void Dispose() => FormContext?.UnregisterField(_fieldId);
}
