@namespace Cheetah.AspNetCore.Blazor.Controls
@typeparam TValue where TValue : struct, IConvertible

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label @(Required ? "crm-label-required" : "")">@Label</label>
    }
    <input type="number"
           class="form-control @(HasError ? "is-invalid" : "") @Class"
           value="@Value"
           placeholder="@Placeholder"
           disabled="@Disabled"
           readonly="@ReadOnly"
           min="@Min"
           max="@Max"
           step="@Step"
           @oninput="OnInput" />
    @if (HasError)
    {
        <div class="invalid-feedback">@Error</div>
    }
    @if (!string.IsNullOrEmpty(Hint) && !HasError)
    {
        <div class="form-text">@Hint</div>
    }
</div>

@code {
    [Parameter] public TValue? Value       { get; set; }
    [Parameter] public string  Label       { get; set; } = string.Empty;
    [Parameter] public string  Placeholder { get; set; } = string.Empty;
    [Parameter] public string? Error       { get; set; }
    [Parameter] public string  Hint        { get; set; } = string.Empty;
    [Parameter] public string  Class       { get; set; } = string.Empty;
    [Parameter] public bool    Disabled    { get; set; }
    [Parameter] public bool    ReadOnly    { get; set; }
    [Parameter] public bool    Required    { get; set; }
    [Parameter] public string? Min         { get; set; }
    [Parameter] public string? Max         { get; set; }
    [Parameter] public string  Step        { get; set; } = "1";
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);

    private Task OnInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (string.IsNullOrEmpty(raw))
            return ValueChanged.InvokeAsync(null);

        try
        {
            var converted = (TValue)Convert.ChangeType(raw, typeof(TValue));
            return ValueChanged.InvokeAsync(converted);
        }
        catch
        {
            return Task.CompletedTask;
        }
    }
}
