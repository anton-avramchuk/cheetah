@namespace Cheetah.AspNetCore.Blazor.Controls

<div class="mb-3">
    <div class="form-check">
        <input type="checkbox"
               class="form-check-input @(HasError ? "is-invalid" : "") @Class"
               id="@_id"
               checked="@Value"
               disabled="@Disabled"
               @onchange="OnChange" />
        @if (!string.IsNullOrEmpty(Label))
        {
            <label class="form-check-label" for="@_id">@Label</label>
        }
        @if (HasError)
        {
            <div class="invalid-feedback">@Error</div>
        }
    </div>
    @if (!string.IsNullOrEmpty(Hint) && !HasError)
    {
        <div class="form-text">@Hint</div>
    }
</div>

@code {
    [Parameter] public bool    Value    { get; set; }
    [Parameter] public string  Label    { get; set; } = string.Empty;
    [Parameter] public string? Error    { get; set; }
    [Parameter] public string  Hint     { get; set; } = string.Empty;
    [Parameter] public string  Class    { get; set; } = string.Empty;
    [Parameter] public bool    Disabled { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    private readonly string _id = $"chk-{Guid.NewGuid():N}";
    private bool HasError => !string.IsNullOrEmpty(Error);

    private Task OnChange(ChangeEventArgs e)
        => ValueChanged.InvokeAsync(e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var r) && r);
}
