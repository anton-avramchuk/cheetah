@namespace Cheetah.AspNetCore.Blazor.Controls

<div class="mb-3 @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label">@Label</label>
    }
    <ul class="nav @NavClass mb-3" role="tablist">
        @foreach (var tab in _tabs)
        {
            var t = tab;
            <li class="nav-item" role="presentation">
                <button class="nav-link @(t.Key == _active ? "active" : "") @(t.Disabled ? "disabled" : "")"
                        role="tab"
                        type="button"
                        @onclick="() => Activate(t.Key)">
                    @t.Title
                    @if (!string.IsNullOrEmpty(t.Badge))
                    {
                        <span class="crm-tab-badge">@t.Badge</span>
                    }
                </button>
            </li>
        }
    </ul>
    <CascadingValue Value="this" IsFixed="true">
        <div class="tab-content">
            @ChildContent
        </div>
    </CascadingValue>
</div>

@code {
    internal sealed class TabInfo(string key, string title, bool disabled, string? badge)
    {
        public string Key { get; } = key;
        public string Title { get; set; } = title;
        public bool Disabled { get; set; } = disabled;
        public string? Badge { get; set; } = badge;
    }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public bool   Pills { get; set; }
    [Parameter] public EventCallback<string> OnTabChanged { get; set; }

    /// <summary>
    /// Default lazy-initialization mode for child panels. When <c>true</c>, a panel's
    /// content is created on first activation and then kept alive (hidden via CSS),
    /// so it initializes only once. When <c>false</c> (default), content is rendered
    /// only while the panel is active and is destroyed on every switch.
    /// Individual <see cref="CrmTabPanel"/>s can override this via their own Lazy parameter.
    /// </summary>
    [Parameter] public bool Lazy { get; set; }

    private string NavClass => Pills ? "nav-pills" : "nav-tabs";
    private string _active = string.Empty;
    private readonly List<TabInfo> _tabs = [];

    internal void RegisterTab(string key, string title, bool disabled, string? badge)
    {
        if (_tabs.All(t => t.Key != key))
        {
            _tabs.Add(new TabInfo(key, title, disabled, badge));
            if (_active == string.Empty) _active = key;
            StateHasChanged();
        }
    }

    // Обновление динамических атрибутов таба (заголовок/бейдж/disabled) после регистрации —
    // вызывается панелью из OnParametersSet, чтобы счётчик на табе жил и менялся во времени.
    internal void UpdateTab(string key, string title, bool disabled, string? badge)
    {
        var tab = _tabs.FirstOrDefault(t => t.Key == key);
        if (tab is null || (tab.Title == title && tab.Disabled == disabled && tab.Badge == badge))
            return;

        tab.Title = title;
        tab.Disabled = disabled;
        tab.Badge = badge;
        StateHasChanged();
    }

    internal bool IsActive(string key) => key == _active;

    private Task Activate(string key)
    {
        _active = key;
        return OnTabChanged.InvokeAsync(key);
    }
}
