@namespace Cheetah.AspNetCore.Blazor.Controls
@typeparam TValue
@implements IDisposable

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label @(Required ? "crm-label-required" : "")">@Label</label>
    }

    <div class="crm-select @(_open ? "crm-select--open" : "")">
        <div class="form-select text-start crm-select__toggle @(Disabled ? "disabled" : "") @(IsInvalid ? "is-invalid" : "") @Class"
             role="button"
             tabindex="@(Disabled ? -1 : 0)"
             aria-haspopup="listbox"
             aria-expanded="@_open"
             aria-disabled="@Disabled"
             @onclick="Toggle"
             @onkeydown="OnToggleKeyDown"
             @onfocusout="MarkTouched">
            @if (!HasSelection)
            {
                <span class="crm-select__placeholder">@Placeholder</span>
            }
            else if (Multiple)
            {
                @foreach (var item in SelectedValues)
                {
                    <span class="crm-select__chip">
                        @RenderSelected(item)
                        @if (!Disabled)
                        {
                            <span class="crm-select__chip-remove"
                                  role="button"
                                  aria-label="Удалить"
                                  @onclick:stopPropagation="true"
                                  @onclick="() => Toggle(item)">×</span>
                        }
                    </span>
                }
            }
            else
            {
                @RenderSelected(Value!)
            }
        </div>

        @if (_open)
        {
            <div class="crm-select__backdrop" @onclick="Close"></div>
            <ul class="crm-select__menu" role="listbox" aria-multiselectable="@Multiple">
                @foreach (var item in Items)
                {
                    var selected = IsSelected(item);
                    <li role="option" aria-selected="@selected">
                        <button type="button"
                                class="crm-select__option @(selected ? "crm-select__option--selected" : "")"
                                @onclick="() => Select(item)">
                            @RenderItem(item)
                            @if (selected)
                            {
                                <svg class="crm-select__check" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                            }
                        </button>
                    </li>
                }
            </ul>
        }
    </div>

    @if (HasExternalError)
    {
        <div class="invalid-feedback d-block">@Error</div>
    }
    else if (ShowValidationError)
    {
        <div class="invalid-feedback d-block">Выберите значение</div>
    }
    @if (!string.IsNullOrEmpty(Hint) && !HasExternalError && !ShowValidationError)
    {
        <div class="form-text">@Hint</div>
    }
</div>

@code {
    [CascadingParameter] public DialogFormContext? FormContext { get; set; }

    [Parameter] public TValue?             Value         { get; set; }
    [Parameter] public IEnumerable<TValue> Items         { get; set; } = [];
    [Parameter] public string              Label         { get; set; } = string.Empty;
    [Parameter] public string              Placeholder   { get; set; } = string.Empty;
    [Parameter] public string?             Error         { get; set; }
    [Parameter] public string              Hint          { get; set; } = string.Empty;
    [Parameter] public string              Class         { get; set; } = string.Empty;
    [Parameter] public bool                Disabled      { get; set; }
    [Parameter] public bool                Required      { get; set; }
    [Parameter] public Func<TValue, string>   KeySelector   { get; set; } = v => v?.ToString() ?? "";
    [Parameter] public Func<TValue, string>   LabelSelector { get; set; } = v => v?.ToString() ?? "";
    [Parameter] public EventCallback<TValue?> ValueChanged  { get; set; }

    /// <summary>Множественный выбор. В этом режиме значение — <see cref="Values"/>/<see cref="ValuesChanged"/>, а <see cref="Value"/> не используется.</summary>
    [Parameter] public bool Multiple { get; set; }
    /// <summary>Выбранные значения в режиме <see cref="Multiple"/> (поддерживает <c>@bind-Values</c>).</summary>
    [Parameter] public IReadOnlyCollection<TValue> Values { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyCollection<TValue>> ValuesChanged { get; set; }

    /// <summary>Шаблон элемента списка. Если не задан — выводится <see cref="LabelSelector"/>.</summary>
    [Parameter] public RenderFragment<TValue>? ItemTemplate { get; set; }
    /// <summary>Шаблон выбранного значения (в свёрнутом виде / в чипе). Если не задан — используется <see cref="ItemTemplate"/>, иначе <see cref="LabelSelector"/>.</summary>
    [Parameter] public RenderFragment<TValue>? SelectedTemplate { get; set; }

    private readonly string _fieldId = Guid.NewGuid().ToString("N");
    private bool _touched;
    private bool _open;

    private IReadOnlyCollection<TValue> SelectedValues => Values ?? [];
    // Для value-типов (Guid, int, enum) Value никогда не null — «не выбрано» = значение по умолчанию.
    private bool HasSelection        => Multiple
        ? SelectedValues.Count > 0
        : Value is not null && !EqualityComparer<TValue>.Default.Equals(Value, default!);
    private bool HasExternalError    => !string.IsNullOrEmpty(Error);
    private bool ShowValidationError => Required && !HasSelection && _touched;
    private bool IsInvalid           => HasExternalError || ShowValidationError;

    protected override void OnInitialized()
    {
        if (Required && FormContext is not null)
            FormContext.SetField(_fieldId, HasSelection);
    }

    private RenderFragment RenderItem(TValue item) => ItemTemplate is not null
        ? ItemTemplate(item)
        : builder => builder.AddContent(0, LabelSelector(item));

    private RenderFragment RenderSelected(TValue item) =>
        (SelectedTemplate ?? ItemTemplate) is { } tpl
            ? tpl(item)
            : builder => builder.AddContent(0, LabelSelector(item));

    private static bool Equal(TValue a, TValue b) => EqualityComparer<TValue>.Default.Equals(a, b);

    private bool IsSelected(TValue item) => Multiple
        ? SelectedValues.Any(v => Equal(v, item))
        : Equal(item, Value!);

    private void Toggle()
    {
        if (Disabled) return;
        _open = !_open;
        if (!_open) MarkTouched();
    }

    private void Close()
    {
        _open = false;
        MarkTouched();
    }

    private Task Select(TValue item) => Multiple ? Toggle(item) : SelectSingle(item);

    private async Task SelectSingle(TValue item)
    {
        _open = false;
        _touched = true;
        UpdateFormField(item is not null);
        await ValueChanged.InvokeAsync(item);
    }

    /// <summary>Переключает элемент в множественном выборе (меню остаётся открытым).</summary>
    private async Task Toggle(TValue item)
    {
        _touched = true;
        var list = SelectedValues.ToList();
        var idx = list.FindIndex(v => Equal(v, item));
        if (idx >= 0)
            list.RemoveAt(idx);
        else
            list.Add(item);

        UpdateFormField(list.Count > 0);
        await ValuesChanged.InvokeAsync(list);
    }

    private void OnToggleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                _open = false;
                break;
            case "Enter" or " " or "ArrowDown" when !_open:
                _open = true;
                break;
        }
    }

    private void UpdateFormField(bool hasValue)
    {
        if (Required && FormContext is not null)
            FormContext.SetField(_fieldId, hasValue);
    }

    private void MarkTouched() => _touched = true;

    public void Dispose() => FormContext?.UnregisterField(_fieldId);
}
