@namespace Cheetah.Blazor.Layout.Components
@inherits LayoutComponentBase
@using Cheetah.Blazor.Components.Dialogs

@inject ILayoutConfiguration Config

<div class="crm-layout @(_sidebarCollapsed ? "sidebar-collapsed" : "")">
    <CrmHeader OnToggleSidebar="ToggleSidebar" />

    <div class="crm-body">
        <CrmSidebar IsCollapsed="@_sidebarCollapsed" />

        <main class="crm-main">
            <div class="crm-content">
                @Body
            </div>
        </main>
    </div>
</div>

<CrmDialogProvider />

@code {
    private bool _sidebarCollapsed;

    protected override void OnInitialized()
    {
        _sidebarCollapsed = Config.SidebarCollapsedByDefault;
    }

    private void ToggleSidebar()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
    }
}
