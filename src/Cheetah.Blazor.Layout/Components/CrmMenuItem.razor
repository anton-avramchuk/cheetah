@namespace Cheetah.Blazor.Layout.Components

<li class="crm-menu-item @GetItemClasses()">
    @if (Item.Children.Any(c => c.IsVisible))
    {
        <div class="crm-menu-link crm-menu-parent" @onclick="ToggleExpanded">
            @RenderIcon()
            @if (!IsCollapsed)
            {
                <span class="crm-menu-text">@Item.Name</span>
                <Icon Name="@(_isExpanded ? "chevron-down" : "chevron-right")"
                      Set="IconSet.Bootstrap"
                      Size="IconSize.Small"
                      Class="crm-menu-arrow" />
            }
        </div>

        @if (_isExpanded && !IsCollapsed)
        {
            <ul class="crm-submenu">
                @foreach (var child in Item.Children.Where(c => c.IsVisible).OrderBy(c => c.Order))
                {
                    <CrmMenuItem Item="@child" IsCollapsed="@IsCollapsed" CurrentUrl="@CurrentUrl" />
                }
            </ul>
        }
    }
    else if (!string.IsNullOrEmpty(Item.Url))
    {
        <a href="@Item.Url" class="crm-menu-link @(Item.IsDisabled ? "disabled" : "")" target="@Item.Target">
            @RenderIcon()
            @if (!IsCollapsed)
            {
                <span class="crm-menu-text">@Item.Name</span>
            }
        </a>
    }
</li>

@code {
    [Parameter, EditorRequired]
    public MenuItem Item { get; set; } = null!;

    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public string CurrentUrl { get; set; } = "";

    private bool _isExpanded;

    protected override void OnInitialized()
    {
        // Auto-expand if any child is active
        _isExpanded = Item.Children.Any(c => IsActive(c));
    }

    private void ToggleExpanded()
    {
        _isExpanded = !_isExpanded;
    }

    private bool IsActive(MenuItem item)
    {
        if (!string.IsNullOrEmpty(item.Url))
        {
            var itemPath = item.Url.TrimStart('/');
            return CurrentUrl.Equals(itemPath, StringComparison.OrdinalIgnoreCase) ||
                   CurrentUrl.StartsWith(itemPath + "/", StringComparison.OrdinalIgnoreCase);
        }
        return item.Children.Any(IsActive);
    }

    private string GetItemClasses()
    {
        var classes = new List<string>();

        if (IsActive(Item))
            classes.Add("active");

        if (Item.Children.Any(c => c.IsVisible))
            classes.Add("has-children");

        if (_isExpanded)
            classes.Add("expanded");

        if (!string.IsNullOrEmpty(Item.CssClass))
            classes.Add(Item.CssClass);

        return string.Join(" ", classes);
    }

    private RenderFragment RenderIcon() => builder =>
    {
        // New format: IconName + IconSet
        if (!string.IsNullOrEmpty(Item.IconName))
        {
            builder.OpenComponent<Icon>(0);
            builder.AddAttribute(1, "Name", Item.IconName);
            builder.AddAttribute(2, "Set", Item.IconSet);
            builder.AddAttribute(3, "Size", IconSize.Medium);
            builder.AddAttribute(4, "Class", "crm-menu-icon");
            builder.CloseComponent();
        }
        // Legacy format: Icon as CSS class
#pragma warning disable CS0618 // Type or member is obsolete
        else if (!string.IsNullOrEmpty(Item.Icon))
        {
            builder.OpenElement(0, "i");
            builder.AddAttribute(1, "class", $"crm-menu-icon {Item.Icon}");
            builder.CloseElement();
        }
#pragma warning restore CS0618
    };
}
