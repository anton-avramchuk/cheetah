@namespace Cheetah.Blazor.Layout.Components
@using Cheetah.Blazor.Components.Icons

@inject ILayoutConfiguration Config
@inject IHeaderComponentProvider HeaderComponents

<header class="crm-header">
    <div class="crm-header-left">
        <button class="crm-sidebar-toggle btn btn-link" @onclick="OnToggleSidebar">
            <Icon Name="list" Size="IconSize.Large" />
        </button>

        <a href="@Config.HomeUrl" class="crm-brand">
            @if (!string.IsNullOrEmpty(Config.LogoUrl))
            {
                <img src="@Config.LogoUrl" alt="@Config.ApplicationName" class="crm-logo" />
            }
            else
            {
                <div class="crm-logo-placeholder">
                    <Icon Name="lightning-charge-fill" Size="IconSize.Large" />
                </div>
            }
            <span class="crm-app-name">@Config.ApplicationName</span>
        </a>
    </div>

    <div class="crm-header-right">
        @foreach (var component in HeaderComponents.GetComponents())
        {
            var comp = component;
            <div class="crm-header-component" @key="comp.ComponentType">
                @RenderComponent(comp.ComponentType, comp.Parameters)
            </div>
        }
    </div>
</header>

@code {
    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    private static RenderFragment RenderComponent(Type type, IDictionary<string, object>? parameters) => builder =>
    {
        builder.OpenComponent(0, type);
        if (parameters != null)
        {
            foreach (var (key, value) in parameters)
                builder.AddAttribute(1, key, value);
        }
        builder.CloseComponent();
    };
}
