@namespace Cheetah.Blazor.Components.Navigation

@* Individual tab panel component - use inside CrmTabs *@

@if (IsActive)
{
    <div class="tab-pane fade show active" role="tabpanel">
        @ChildContent
    </div>
}

@code {
    /// <summary>
    /// Tab title displayed in the tab header
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "";

    /// <summary>
    /// Bootstrap icon name (without 'bi-' prefix)
    /// </summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>
    /// Tab content
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Is tab disabled
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Unique identifier for the tab (auto-generated if not provided)
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    [CascadingParameter]
    private CrmTabs? Parent { get; set; }

    internal bool IsActive => Parent?.ActiveTabId == TabId;
    internal string TabId => Id ?? $"tab-{GetHashCode()}";

    protected override void OnInitialized()
    {
        Parent?.AddTab(this);
    }

    public void Dispose()
    {
        Parent?.RemoveTab(this);
    }
}
