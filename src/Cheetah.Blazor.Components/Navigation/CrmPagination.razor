@namespace Cheetah.Blazor.Components.Navigation

@* Pagination component *@

<nav aria-label="Page navigation">
    <ul class="pagination @GetAlignmentClass()">
        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" href="#" @onclick="@(() => NavigateToPage(1))" @onclick:preventDefault>
                <i class="bi bi-chevron-double-left"></i>
            </a>
        </li>
        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" href="#" @onclick="@(() => NavigateToPage(CurrentPage - 1))" @onclick:preventDefault>
                <i class="bi bi-chevron-left"></i>
            </a>
        </li>

        @foreach (var pageNumber in GetVisiblePages())
        {
            <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                <a class="page-link" href="#" @onclick="@(() => NavigateToPage(pageNumber))" @onclick:preventDefault>
                    @pageNumber
                </a>
            </li>
        }

        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
            <a class="page-link" href="#" @onclick="@(() => NavigateToPage(CurrentPage + 1))" @onclick:preventDefault>
                <i class="bi bi-chevron-right"></i>
            </a>
        </li>
        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
            <a class="page-link" href="#" @onclick="@(() => NavigateToPage(TotalPages))" @onclick:preventDefault>
                <i class="bi bi-chevron-double-right"></i>
            </a>
        </li>
    </ul>
</nav>

@code {
    /// <summary>
    /// Current page (1-indexed)
    /// </summary>
    [Parameter]
    public int CurrentPage { get; set; } = 1;

    /// <summary>
    /// Total number of pages
    /// </summary>
    [Parameter]
    public int TotalPages { get; set; } = 1;

    /// <summary>
    /// Maximum number of page buttons to show
    /// </summary>
    [Parameter]
    public int MaxVisiblePages { get; set; } = 5;

    /// <summary>
    /// Pagination alignment (Start, Center, End)
    /// </summary>
    [Parameter]
    public PaginationAlignment Alignment { get; set; } = PaginationAlignment.Start;

    /// <summary>
    /// Event fired when page changes
    /// </summary>
    [Parameter]
    public EventCallback<int> OnPageChanged { get; set; }

    private async Task NavigateToPage(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage)
            return;

        await OnPageChanged.InvokeAsync(page);
    }

    private IEnumerable<int> GetVisiblePages()
    {
        var pages = new List<int>();

        if (TotalPages <= MaxVisiblePages)
        {
            // Show all pages
            for (int i = 1; i <= TotalPages; i++)
            {
                pages.Add(i);
            }
        }
        else
        {
            // Calculate range around current page
            int halfRange = MaxVisiblePages / 2;
            int start = Math.Max(1, CurrentPage - halfRange);
            int end = Math.Min(TotalPages, start + MaxVisiblePages - 1);

            // Adjust start if end is at max
            if (end == TotalPages)
            {
                start = Math.Max(1, end - MaxVisiblePages + 1);
            }

            for (int i = start; i <= end; i++)
            {
                pages.Add(i);
            }
        }

        return pages;
    }

    private string GetAlignmentClass() => Alignment switch
    {
        PaginationAlignment.Center => "justify-content-center",
        PaginationAlignment.End => "justify-content-end",
        _ => ""
    };

    public enum PaginationAlignment
    {
        Start,
        Center,
        End
    }
}
