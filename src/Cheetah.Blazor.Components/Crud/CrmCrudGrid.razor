@namespace Cheetah.Blazor.Components.Crud
@typeparam TGridViewModel where TGridViewModel : IGridViewModel
@typeparam TCreateViewModel
@typeparam TEditViewModel
@implements IDisposable

@using Cheetah.Blazor.Components.Buttons
@using Cheetah.Blazor.Components.Dialogs
@using Cheetah.Blazor.Components.Display
@using Cheetah.Blazor.Components.Feedback
@using Cheetah.Blazor.Components.Layout

<CrmCard>
    <Header>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0">@Title</h5>
            <div class="d-flex align-items-center gap-2">
                @if (AllowSearch)
                {
                    <div class="input-group input-group-sm" style="width: 250px;">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control"
                               placeholder="@SearchPlaceholder"
                               value="@_searchText"
                               @oninput="OnSearchInput" />
                        @if (!string.IsNullOrEmpty(_searchText))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearchAsync">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                }
                @if (AllowCreate && CreateFormType != null)
                {
                    <CrmButton Text="@CreateButtonText" Icon="plus" OnClick="OpenCreateDialogAsync" />
                }
            </div>
        </div>
    </Header>
    <ChildContent>
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <CrmAlert Variant="ColorVariant.Danger" Message="@_errorMessage" Dismissible="true" />
        }

        @if (_isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@LoadingMessage</span>
                </div>
                <div class="mt-2">@LoadingMessage</div>
            </div>
        }
        else if (_items == null || _items.Count == 0)
        {
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle me-2"></i>
                @EmptyMessage
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            @foreach (var column in _columns)
                            {
                                <th class="@column.GetAlignmentClass()" style="@column.GetWidthStyle()">
                                    @column.DisplayName
                                </th>
                            }
                            @if (HasActions)
                            {
                                <th style="width: @ActionsColumnWidth;">@ActionsColumnHeader</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _items)
                        {
                            <tr>
                                @foreach (var column in _columns)
                                {
                                    var value = column.GetValue(item);
                                    <td class="@(column.CssClass) @column.GetAlignmentClass()">
                                        @if (column.Template == GridColumnTemplate.Color)
                                        {
                                            <CrmColorDisplay Color="@(value?.ToString())" />
                                        }else if (column.Template == GridColumnTemplate.CheckBox)
                                        {
                                            <CrmBooleanDisplay Value="Convert.ToBoolean(value)"/>
                                        }
                                        else
                                        {
                                            @column.FormatValue(value)
                                        }
                                    </td>
                                }
                                @if (HasActions)
                                {
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            @if (AllowEdit && EditFormType != null)
                                            {
                                                <CrmButton Icon="pencil"
                                                           Variant="ColorVariant.Secondary"
                                                           Size="CrmButton.ButtonSize.Small"
                                                           OnClick="() => OpenEditDialogAsync(item.Id)" />
                                            }
                                            @if (AllowDelete)
                                            {
                                                <CrmButton Icon="trash"
                                                           Variant="ColorVariant.Danger"
                                                           Size="CrmButton.ButtonSize.Small"
                                                           OnClick="() => DeleteAsync(item)" />
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Pagination *@
            @if (_totalPages > 1 || PageSizeOptions.Length > 1)
            {
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">Показано:</span>
                        <select class="form-select form-select-sm" style="width: auto;" @onchange="OnPageSizeChangedAsync">
                            @foreach (var size in PageSizeOptions)
                            {
                                <option value="@size" selected="@(size == _currentPageSize)">@size</option>
                            }
                        </select>
                        <span class="text-muted small">
                            из @_totalItems
                        </span>
                    </div>

                    @if (_totalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="GoToFirstPageAsync" disabled="@(_currentPage == 1)">
                                        <i class="bi bi-chevron-double-left"></i>
                                    </button>
                                </li>
                                <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="GoToPreviousPageAsync" disabled="@(_currentPage == 1)">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>
                                </li>

                                @foreach (var pageNum in GetVisiblePageNumbers())
                                {
                                    <li class="page-item @(pageNum == _currentPage ? "active" : "")">
                                        <button class="page-link" @onclick="() => GoToPageAsync(pageNum)">
                                            @pageNum
                                        </button>
                                    </li>
                                }

                                <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="GoToNextPageAsync" disabled="@(_currentPage == _totalPages)">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                </li>
                                <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="GoToLastPageAsync" disabled="@(_currentPage == _totalPages)">
                                        <i class="bi bi-chevron-double-right"></i>
                                    </button>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            }
        }
    </ChildContent>
</CrmCard>
