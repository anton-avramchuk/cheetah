@namespace Cheetah.Blazor.Components.Fonts

@*
    Google Fonts CDN component - loads Roboto and Inter from Google's CDN.
    Include this in your <head> section or use with <HeadContent>.

    Note: Using Google CDN means user IP addresses are sent to Google servers.
    For GDPR compliance, consider using GoogleFontsLocal instead.
*@

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
