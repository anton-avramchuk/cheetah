@namespace Cheetah.Blazor.Components.Forms
@using System.Diagnostics.CodeAnalysis

@* Text area with validation integration *@
@inherits InputBase<string>

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@Id" class="form-label">
            @Label
            @if (Required)
            {
                <span class="text-danger">*</span>
            }
        </label>
    }

    <textarea id="@Id"
              class="@GetInputClass()"
              placeholder="@Placeholder"
              disabled="@Disabled"
              rows="@Rows"
              @bind="CurrentValue"
              @bind:event="oninput"></textarea>

    @if (!string.IsNullOrEmpty(HelpText))
    {
        <div class="form-text">@HelpText</div>
    }

    <ValidationMessage For="@ValidationFor" />
</div>

@code {
    /// <summary>
    /// Input label
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Input placeholder
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Number of rows
    /// </summary>
    [Parameter]
    public int Rows { get; set; } = 3;

    /// <summary>
    /// Is input required
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Is input disabled
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Help text displayed below input
    /// </summary>
    [Parameter]
    public string? HelpText { get; set; }

    /// <summary>
    /// Expression for validation
    /// </summary>
    [Parameter]
    public Expression<Func<string>>? ValidationFor { get; set; }

    /// <summary>
    /// Additional CSS classes
    /// </summary>
    [Parameter]
    public new string? CssClass { get; set; }

    private string Id { get; } = Guid.NewGuid().ToString();

    private string GetInputClass()
    {
        var classes = new List<string> { "form-control" };

        if (EditContext != null && ValidationFor != null)
        {
            var fieldIdentifier = FieldIdentifier.Create(ValidationFor);
            var isModified = EditContext.IsModified(fieldIdentifier);
            var isInvalid = EditContext.GetValidationMessages(fieldIdentifier).Any();

            if (isModified && isInvalid)
                classes.Add("is-invalid");
            else if (isModified)
                classes.Add("is-valid");
        }

        if (!string.IsNullOrEmpty(CssClass))
            classes.Add(CssClass);

        return string.Join(" ", classes);
    }

    protected override bool TryParseValueFromString(string? value, out string result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = null;
        return true;
    }
}
