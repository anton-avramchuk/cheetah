@namespace Cheetah.Blazor.Components.Forms
@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@using Microsoft.JSInterop

@inherits InputBase<string?>
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@_inputId" class="form-label">
            @Label
            @if (Required)
            {
                <span class="text-danger">*</span>
            }
        </label>
    }

    <div class="crm-colorpicker" id="@_containerId" @onfocusout="OnFocusOut" tabindex="-1">
        <div class="crm-colorpicker-input-group">
            <button type="button"
                    class="crm-colorpicker-preview"
                    disabled="@Disabled"
                    @onclick="ToggleDropdown"
                    @onclick:stopPropagation="true">
                <span class="crm-colorpicker-preview-inner">
                    <span class="crm-colorpicker-preview-color"
                          style="background-color: @GetRgbaString();"></span>
                </span>
            </button>

            <input type="text"
                   id="@_inputId"
                   class="@GetInputClass()"
                   placeholder="@(Placeholder ?? "#000000")"
                   disabled="@Disabled"
                   value="@CurrentValueAsString"
                   @onchange="OnHexInputChanged"
                   @onfocus="CloseDropdown" />
        </div>

        @if (_isOpen)
        {
            <div class="crm-colorpicker-dropdown" @onclick:stopPropagation="true">
                @* Gradient square *@
                <div class="crm-colorpicker-gradient"
                     data-picker="gradient"
                     style="background-color: hsl(@_hue, 100%, 50%);"
                     @onpointerdown="OnGradientPointerDown"
                     @onpointerdown:preventDefault="true">
                    <div class="crm-colorpicker-gradient-white"></div>
                    <div class="crm-colorpicker-gradient-black"></div>
                    <div class="crm-colorpicker-gradient-cursor"
                         style="left: @Pct(_saturation); top: @Pct(1 - _value);"></div>
                </div>

                <div class="crm-colorpicker-sliders">
                    @* Hue slider *@
                    <div class="crm-colorpicker-slider crm-colorpicker-hue"
                         data-picker="hue"
                         @onpointerdown="OnHuePointerDown"
                         @onpointerdown:preventDefault="true">
                        <div class="crm-colorpicker-slider-thumb"
                             style="left: @Pct(_hue / 360.0);"></div>
                    </div>

                    @* Alpha slider *@
                    <div class="crm-colorpicker-slider crm-colorpicker-alpha"
                         data-picker="alpha"
                         @onpointerdown="OnAlphaPointerDown"
                         @onpointerdown:preventDefault="true">
                        <div class="crm-colorpicker-alpha-gradient"
                             style="background: linear-gradient(to right, transparent, @GetOpaqueRgbString()); border-radius: 7px;"></div>
                        <div class="crm-colorpicker-slider-thumb"
                             style="left: @Pct(_alpha);"></div>
                    </div>
                </div>

                @* Hex display *@
                <div class="crm-colorpicker-hex-row">
                    <div class="crm-colorpicker-result-swatch">
                        <div class="crm-colorpicker-result-color"
                             style="background-color: @GetRgbaString();"></div>
                    </div>
                    <input type="text"
                           value="@GetDisplayHex()"
                           @onchange="OnDropdownHexChanged" />
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(HelpText))
    {
        <div class="form-text">@HelpText</div>
    }

    <ValidationMessage For="@ValidationFor" />
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public Expression<Func<string?>>? ValidationFor { get; set; }
    [Parameter] public new string? CssClass { get; set; }

    private readonly string _containerId = $"cp-{Guid.NewGuid():N}";
    private readonly string _inputId = $"cpi-{Guid.NewGuid():N}";
    private DotNetObjectReference<CrmColorPicker>? _dotNetRef;
    private bool _isOpen;
    private bool _jsInitialized;

    // HSV + Alpha state
    private double _hue;        // 0-360
    private double _saturation; // 0-1
    private double _value = 1;  // 0-1
    private double _alpha = 1;  // 0-1

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        ParseCurrentValue();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isOpen && !_jsInitialized)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("CrmColorPicker.init", _dotNetRef, _containerId);
            _jsInitialized = true;
        }
    }

    [JSInvokable]
    public void OnPointerInput(string target, double x, double y)
    {
        switch (target)
        {
            case "gradient":
                _saturation = x;
                _value = 1 - y;
                break;
            case "hue":
                _hue = x * 360;
                break;
            case "alpha":
                _alpha = x;
                break;
        }
        ApplyHsvToValue();
        InvokeAsync(StateHasChanged);
    }

    private void OnGradientPointerDown(PointerEventArgs e)
        => JS.InvokeVoidAsync("CrmColorPicker.startDrag", _containerId, "gradient", new { e.ClientX, e.ClientY });

    private void OnHuePointerDown(PointerEventArgs e)
        => JS.InvokeVoidAsync("CrmColorPicker.startDrag", _containerId, "hue", new { e.ClientX, e.ClientY });

    private void OnAlphaPointerDown(PointerEventArgs e)
        => JS.InvokeVoidAsync("CrmColorPicker.startDrag", _containerId, "alpha", new { e.ClientX, e.ClientY });

    private void OnHexInputChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        CurrentValueAsString = val;
        ParseCurrentValue();
    }

    private void OnDropdownHexChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(val))
        {
            CurrentValueAsString = val;
            ParseCurrentValue();
        }
    }

    private void ToggleDropdown() => _isOpen = !_isOpen;
    private void CloseDropdown() => _isOpen = false;

    private void OnFocusOut()
    {
        _isOpen = false;
        if (_jsInitialized)
        {
            _ = JS.InvokeVoidAsync("CrmColorPicker.dispose", _containerId);
            _jsInitialized = false;
        }
    }

    // --- Color conversions ---

    private void ParseCurrentValue()
    {
        var hex = CurrentValueAsString?.Trim();
        if (string.IsNullOrEmpty(hex)) return;
        if (!hex.StartsWith('#')) hex = "#" + hex;

        if (TryParseHex(hex, out var r, out var g, out var b, out var a))
        {
            RgbToHsv(r, g, b, out _hue, out _saturation, out _value);
            _alpha = a;
        }
    }

    private void ApplyHsvToValue()
    {
        HsvToRgb(_hue, _saturation, _value, out var r, out var g, out var b);

        CurrentValueAsString = _alpha < 1.0
            ? $"#{r:X2}{g:X2}{b:X2}{(int)Math.Round(_alpha * 255):X2}"
            : $"#{r:X2}{g:X2}{b:X2}";
    }

    private string GetRgbaString()
    {
        HsvToRgb(_hue, _saturation, _value, out var r, out var g, out var b);
        return $"rgba({r},{g},{b},{_alpha.ToString("F2", CultureInfo.InvariantCulture)})";
    }

    private string GetOpaqueRgbString()
    {
        HsvToRgb(_hue, _saturation, _value, out var r, out var g, out var b);
        return $"rgb({r},{g},{b})";
    }

    private string GetDisplayHex()
    {
        HsvToRgb(_hue, _saturation, _value, out var r, out var g, out var b);
        return _alpha < 1.0
            ? $"#{r:X2}{g:X2}{b:X2}{(int)Math.Round(_alpha * 255):X2}"
            : $"#{r:X2}{g:X2}{b:X2}";
    }

    private static string Pct(double v)
        => $"{(v * 100).ToString("F1", CultureInfo.InvariantCulture)}%";

    private static bool TryParseHex(string hex, out int r, out int g, out int b, out double a)
    {
        r = g = b = 0; a = 1;
        hex = hex.TrimStart('#');

        if (hex.Length == 6 &&
            int.TryParse(hex[..2], NumberStyles.HexNumber, null, out r) &&
            int.TryParse(hex[2..4], NumberStyles.HexNumber, null, out g) &&
            int.TryParse(hex[4..6], NumberStyles.HexNumber, null, out b))
        {
            return true;
        }

        if (hex.Length == 8 &&
            int.TryParse(hex[..2], NumberStyles.HexNumber, null, out r) &&
            int.TryParse(hex[2..4], NumberStyles.HexNumber, null, out g) &&
            int.TryParse(hex[4..6], NumberStyles.HexNumber, null, out b) &&
            int.TryParse(hex[6..8], NumberStyles.HexNumber, null, out var ai))
        {
            a = ai / 255.0;
            return true;
        }

        return false;
    }

    private static void RgbToHsv(int r, int g, int b, out double h, out double s, out double v)
    {
        double rd = r / 255.0, gd = g / 255.0, bd = b / 255.0;
        var max = Math.Max(rd, Math.Max(gd, bd));
        var min = Math.Min(rd, Math.Min(gd, bd));
        var delta = max - min;

        h = 0;
        if (delta > 0)
        {
            if (max == rd) h = 60 * (((gd - bd) / delta) % 6);
            else if (max == gd) h = 60 * (((bd - rd) / delta) + 2);
            else h = 60 * (((rd - gd) / delta) + 4);
        }
        if (h < 0) h += 360;

        s = max == 0 ? 0 : delta / max;
        v = max;
    }

    private static void HsvToRgb(double h, double s, double v, out int r, out int g, out int b)
    {
        var c = v * s;
        var x = c * (1 - Math.Abs((h / 60) % 2 - 1));
        var m = v - c;

        double rd, gd, bd;
        switch ((int)(h / 60) % 6)
        {
            case 0: rd = c; gd = x; bd = 0; break;
            case 1: rd = x; gd = c; bd = 0; break;
            case 2: rd = 0; gd = c; bd = x; break;
            case 3: rd = 0; gd = x; bd = c; break;
            case 4: rd = x; gd = 0; bd = c; break;
            default: rd = c; gd = 0; bd = x; break;
        }

        r = (int)Math.Round((rd + m) * 255);
        g = (int)Math.Round((gd + m) * 255);
        b = (int)Math.Round((bd + m) * 255);
    }

    private string GetInputClass()
    {
        var classes = new List<string> { "form-control" };

        if (EditContext != null && ValidationFor != null)
        {
            var fi = FieldIdentifier.Create(ValidationFor);
            var isModified = EditContext.IsModified(fi);
            var isInvalid = EditContext.GetValidationMessages(fi).Any();

            if (isModified && isInvalid) classes.Add("is-invalid");
            else if (isModified) classes.Add("is-valid");
        }

        if (!string.IsNullOrEmpty(CssClass)) classes.Add(CssClass);
        return string.Join(" ", classes);
    }

    protected override bool TryParseValueFromString(string? value, out string? result,
        [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value;
        validationErrorMessage = null;
        return true;
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsInitialized)
        {
            try { await JS.InvokeVoidAsync("CrmColorPicker.dispose", _containerId); }
            catch (JSDisconnectedException) { }
        }
        _dotNetRef?.Dispose();
    }
}
