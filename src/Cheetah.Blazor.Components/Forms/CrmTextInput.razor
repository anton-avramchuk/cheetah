@namespace Cheetah.Blazor.Components.Forms

@* Text input with validation integration *@
@typeparam TValue
@inherits InputBase<TValue>

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@Id" class="form-label">
            @Label
            @if (Required)
            {
                <span class="text-danger">*</span>
            }
        </label>
    }

    <input type="@InputType"
           id="@Id"
           class="@GetInputClass()"
           placeholder="@Placeholder"
           disabled="@Disabled"
           @bind="CurrentValueAsString"
           @bind:event="oninput" />

    @if (!string.IsNullOrEmpty(HelpText))
    {
        <div class="form-text">@HelpText</div>
    }

    <ValidationMessage For="@ValidationFor" />
</div>

@code {
    /// <summary>
    /// Input label
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Input placeholder
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Input type (text, password, email, etc.)
    /// </summary>
    [Parameter]
    public string InputType { get; set; } = "text";

    /// <summary>
    /// Is input required
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Is input disabled
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Help text displayed below input
    /// </summary>
    [Parameter]
    public string? HelpText { get; set; }

    /// <summary>
    /// Expression for validation
    /// </summary>
    [Parameter]
    public Expression<Func<TValue>>? ValidationFor { get; set; }

    /// <summary>
    /// Additional CSS classes
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    private string Id { get; } = Guid.NewGuid().ToString();

    private string GetInputClass()
    {
        var classes = new List<string> { "form-control" };

        if (EditContext != null && ValidationFor != null)
        {
            var fieldIdentifier = FieldIdentifier.Create(ValidationFor);
            var isModified = EditContext.IsModified(fieldIdentifier);
            var isInvalid = EditContext.GetValidationMessages(fieldIdentifier).Any();

            if (isModified && isInvalid)
                classes.Add("is-invalid");
            else if (isModified)
                classes.Add("is-valid");
        }

        if (!string.IsNullOrEmpty(CssClass))
            classes.Add(CssClass);

        return string.Join(" ", classes);
    }

    protected override bool TryParseValueFromString(string? value, out TValue result, out string? validationErrorMessage)
    {
        if (typeof(TValue) == typeof(string))
        {
            result = (TValue)(object)value!;
            validationErrorMessage = null;
            return true;
        }

        result = default!;
        validationErrorMessage = $"The {FieldIdentifier.FieldName} field is not valid.";
        return false;
    }
}
