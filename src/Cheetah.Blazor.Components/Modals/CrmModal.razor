@namespace Cheetah.Blazor.Components.Modals

@* Modal dialog component *@

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="HandleBackdropClick">
        <div class="modal-dialog @GetDialogClass()" @onclick:stopPropagation="true">
            <div class="modal-content">
                @if (Header != null)
                {
                    <div class="modal-header">
                        @Header
                        @if (ShowCloseButton)
                        {
                            <button type="button" class="btn-close" @onclick="CloseAsync" aria-label="Закрыть"></button>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(Title))
                {
                    <div class="modal-header">
                        <h5 class="modal-title">@Title</h5>
                        @if (ShowCloseButton)
                        {
                            <button type="button" class="btn-close" @onclick="CloseAsync" aria-label="Закрыть"></button>
                        }
                    </div>
                }

                <div class="modal-body">
                    @ChildContent
                </div>

                @if (Footer != null)
                {
                    <div class="modal-footer">
                        @Footer
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Modal title
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Custom header content
    /// </summary>
    [Parameter]
    public RenderFragment? Header { get; set; }

    /// <summary>
    /// Modal body content
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Modal footer content
    /// </summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    /// <summary>
    /// Is modal visible
    /// </summary>
    [Parameter]
    public bool IsVisible { get; set; }

    /// <summary>
    /// Event when visibility changes
    /// </summary>
    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>
    /// Show close button in header
    /// </summary>
    [Parameter]
    public bool ShowCloseButton { get; set; } = true;

    /// <summary>
    /// Close on backdrop click
    /// </summary>
    [Parameter]
    public bool CloseOnBackdropClick { get; set; } = true;

    /// <summary>
    /// Modal size (Small, Default, Large, ExtraLarge)
    /// </summary>
    [Parameter]
    public ModalSize Size { get; set; } = ModalSize.Default;

    /// <summary>
    /// Center modal vertically
    /// </summary>
    [Parameter]
    public bool Centered { get; set; }

    /// <summary>
    /// Enable scrollable body
    /// </summary>
    [Parameter]
    public bool Scrollable { get; set; }

    /// <summary>
    /// Event when modal is closed
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Additional CSS classes
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    public async Task ShowAsync()
    {
        IsVisible = true;
        await IsVisibleChanged.InvokeAsync(true);
    }

    public async Task CloseAsync()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        if (CloseOnBackdropClick)
        {
            await CloseAsync();
        }
    }

    private string GetDialogClass()
    {
        var classes = new List<string>();

        classes.Add(Size switch
        {
            ModalSize.Small => "modal-sm",
            ModalSize.Large => "modal-lg",
            ModalSize.ExtraLarge => "modal-xl",
            _ => ""
        });

        if (Centered)
            classes.Add("modal-dialog-centered");

        if (Scrollable)
            classes.Add("modal-dialog-scrollable");

        if (!string.IsNullOrEmpty(CssClass))
            classes.Add(CssClass);

        return string.Join(" ", classes.Where(c => !string.IsNullOrEmpty(c)));
    }

    public enum ModalSize
    {
        Small,
        Default,
        Large,
        ExtraLarge
    }
}
