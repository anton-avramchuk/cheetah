@namespace Cheetah.Blazor.Components.Icons

@if (Set == IconSet.Bootstrap)
{
    <i class="@GetCssClass()"
       style="@GetStyle()"
       aria-label="@Title"
       role="@(Title != null ? "img" : null)"
       aria-hidden="@(Title == null ? "true" : null)"
       @attributes="AdditionalAttributes"></i>
}
else
{
    <span class="@GetCssClass()"
          style="@GetStyle()"
          aria-label="@Title"
          role="@(Title != null ? "img" : null)"
          aria-hidden="@(Title == null ? "true" : null)"
          @attributes="AdditionalAttributes">@Name</span>
}
