@namespace Cheetah.Blazor.Components.Feedback

@* Alert/notification component *@

@if (IsVisible)
{
    <div class="@GetCssClass()" role="alert">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <i class="bi bi-@Icon me-2"></i>
        }

        @if (ChildContent != null)
        {
            @ChildContent
        }
        else if (!string.IsNullOrEmpty(Message))
        {
            @Message
        }

        @if (Dismissible)
        {
            <button type="button" class="btn-close" @onclick="Dismiss" aria-label="Close"></button>
        }
    </div>
}

@code {
    /// <summary>
    /// Alert variant (Primary, Secondary, Success, Danger, Warning, Info, Light, Dark)
    /// </summary>
    [Parameter]
    public AlertVariant Variant { get; set; } = AlertVariant.Info;

    /// <summary>
    /// Alert message
    /// </summary>
    [Parameter]
    public string? Message { get; set; }

    /// <summary>
    /// Alert content
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Bootstrap icon name (without 'bi-' prefix)
    /// </summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>
    /// Can alert be dismissed
    /// </summary>
    [Parameter]
    public bool Dismissible { get; set; }

    /// <summary>
    /// Is alert visible
    /// </summary>
    [Parameter]
    public bool IsVisible { get; set; } = true;

    /// <summary>
    /// Additional CSS classes
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Event fired when alert is dismissed
    /// </summary>
    [Parameter]
    public EventCallback OnDismissed { get; set; }

    private async Task Dismiss()
    {
        IsVisible = false;
        await OnDismissed.InvokeAsync();
    }

    private string GetCssClass()
    {
        var classes = new List<string> { "alert", $"alert-{GetVariantName()}" };

        if (Dismissible)
            classes.Add("alert-dismissible fade show");

        if (!string.IsNullOrEmpty(CssClass))
            classes.Add(CssClass);

        return string.Join(" ", classes);
    }

    private string GetVariantName() => Variant switch
    {
        AlertVariant.Primary => "primary",
        AlertVariant.Secondary => "secondary",
        AlertVariant.Success => "success",
        AlertVariant.Danger => "danger",
        AlertVariant.Warning => "warning",
        AlertVariant.Info => "info",
        AlertVariant.Light => "light",
        AlertVariant.Dark => "dark",
        _ => "info"
    };

    public enum AlertVariant
    {
        Primary,
        Secondary,
        Success,
        Danger,
        Warning,
        Info,
        Light,
        Dark
    }
}
