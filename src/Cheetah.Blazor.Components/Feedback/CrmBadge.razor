@namespace Cheetah.Blazor.Components.Feedback

@* Badge component for status indicators *@

<span class="@GetCssClass()">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <i class="bi bi-@Icon me-1"></i>
    }
    @if (ChildContent != null)
    {
        @ChildContent
    }
    else if (!string.IsNullOrEmpty(Text))
    {
        @Text
    }
</span>

@code {
    /// <summary>
    /// Badge variant (Primary, Secondary, Success, Danger, Warning, Info, Light, Dark)
    /// </summary>
    [Parameter]
    public BadgeVariant Variant { get; set; } = BadgeVariant.Primary;

    /// <summary>
    /// Badge text
    /// </summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>
    /// Badge content
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Bootstrap icon name (without 'bi-' prefix)
    /// </summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>
    /// Pill style (rounded)
    /// </summary>
    [Parameter]
    public bool Pill { get; set; }

    /// <summary>
    /// Additional CSS classes
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    private string GetCssClass()
    {
        var classes = new List<string> { "badge", $"bg-{GetVariantName()}" };

        if (Pill)
            classes.Add("rounded-pill");

        if (!string.IsNullOrEmpty(CssClass))
            classes.Add(CssClass);

        return string.Join(" ", classes);
    }

    private string GetVariantName() => Variant switch
    {
        BadgeVariant.Primary => "primary",
        BadgeVariant.Secondary => "secondary",
        BadgeVariant.Success => "success",
        BadgeVariant.Danger => "danger",
        BadgeVariant.Warning => "warning",
        BadgeVariant.Info => "info",
        BadgeVariant.Light => "light",
        BadgeVariant.Dark => "dark",
        _ => "primary"
    };

    public enum BadgeVariant
    {
        Primary,
        Secondary,
        Success,
        Danger,
        Warning,
        Info,
        Light,
        Dark
    }
}
