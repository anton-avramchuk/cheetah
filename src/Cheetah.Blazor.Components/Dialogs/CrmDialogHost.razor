@namespace Cheetah.Blazor.Components.Dialogs

@using Cheetah.Blazor.Components.Buttons
@using Cheetah.Blazor.Components.Modals

@implements IDisposable

<CrmModal IsVisible="true"
          Title="@Instance.Options.Title"
          Size="@Instance.Options.Size"
          Centered="@Instance.Options.Centered"
          Scrollable="@Instance.Options.Scrollable"
          ShowCloseButton="@Instance.Options.ShowCloseButton"
          CloseOnBackdropClick="@Instance.Options.CloseOnBackdropClick"
          OnClose="HandleCloseButtonClick">
    <ChildContent>
        <CascadingValue Value="(IDialogFormContext)Instance" IsFixed="true">
            <DynamicComponent Type="Instance.ComponentType"
                              Parameters="Instance.Parameters"
                              @ref="_component" />
        </CascadingValue>
    </ChildContent>
    <Footer>
        @foreach (var btn in GetButtons())
        {
            <CrmButton Text="@btn.Text"
                       Icon="@btn.Icon"
                       Variant="@btn.Variant"
                       Disabled="@(btn.IsConfirm && btn.DisableWhenInvalid && !Instance.IsFormValid)"
                       IsLoading="@(_submitting && btn.IsConfirm)"
                       OnClick="() => HandleButtonClickAsync(btn)" />
        }
    </Footer>
</CrmModal>

@code {
    [Parameter, EditorRequired]
    public DialogInstance Instance { get; set; } = null!;

    [Parameter]
    public EventCallback<DialogResult> OnClose { get; set; }

    private DynamicComponent? _component;
    private bool _submitting;

    protected override void OnInitialized()
    {
        Instance.OnStateChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<DialogButton> GetButtons()
    {
        return Instance.Options.Buttons ?? DialogButtons.SaveCancel;
    }

    private async Task HandleCloseButtonClick()
    {
        await OnClose.InvokeAsync(DialogResult.Cancel());
    }

    private async Task HandleButtonClickAsync(DialogButton btn)
    {
        if (btn.IsCancel)
        {
            await OnClose.InvokeAsync(DialogResult.Cancel());
            return;
        }

        if (btn.IsConfirm)
        {
            await HandleConfirmAsync();
        }
    }

    private async Task HandleConfirmAsync()
    {
        if (_component?.Instance is null)
        {
            await OnClose.InvokeAsync(DialogResult.Ok());
            return;
        }

        var componentInstance = _component.Instance;
        var componentType = componentInstance.GetType();

        // Find IDialogForm<T> interface
        var dialogFormInterface = componentType
            .GetInterfaces()
            .FirstOrDefault(i => i.IsGenericType && i.GetGenericTypeDefinition() == typeof(IDialogForm<>));

        if (dialogFormInterface is null)
        {
            // Component doesn't implement IDialogForm<T>, just close with Ok
            await OnClose.InvokeAsync(DialogResult.Ok());
            return;
        }

        _submitting = true;
        StateHasChanged();

        try
        {
            // Get SubmitAsync method and invoke it
            var submitMethod = dialogFormInterface.GetMethod(nameof(IDialogForm<object>.SubmitAsync));
            if (submitMethod is null)
            {
                await OnClose.InvokeAsync(DialogResult.Ok());
                return;
            }

            var task = submitMethod.Invoke(componentInstance, null);
            if (task is null)
            {
                await OnClose.InvokeAsync(DialogResult.Ok());
                return;
            }

            await (Task)task;

            // Get result from the task
            var resultProperty = task.GetType().GetProperty("Result");
            var formResult = resultProperty?.GetValue(task);

            if (formResult is null)
            {
                await OnClose.InvokeAsync(DialogResult.Ok());
                return;
            }

            // Check Success property
            var successProperty = formResult.GetType().GetProperty(nameof(DialogFormResult<object>.Success));
            var success = successProperty?.GetValue(formResult) as bool? ?? false;

            if (success)
            {
                var dataProperty = formResult.GetType().GetProperty(nameof(DialogFormResult<object>.Data));
                var data = dataProperty?.GetValue(formResult);
                await OnClose.InvokeAsync(DialogResult.Ok(data));
            }
            // If not successful, don't close - let the form show its error
        }
        finally
        {
            _submitting = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Instance.OnStateChanged -= HandleStateChanged;
    }
}
