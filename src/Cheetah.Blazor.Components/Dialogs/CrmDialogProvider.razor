@namespace Cheetah.Blazor.Components.Dialogs

@implements IDisposable

@inject IDialogService DialogService

@foreach (var dialog in _dialogService.Dialogs)
{
    <CrmDialogHost Instance="dialog" OnClose="result => HandleClose(dialog, result)" />
}

@code {
    private IDialogServiceInternal _dialogService = null!;

    protected override void OnInitialized()
    {
        _dialogService = (IDialogServiceInternal)DialogService;
        _dialogService.OnChange += HandleChange;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleClose(DialogInstance instance, DialogResult result)
    {
        _dialogService.CloseDialog(instance, result);
    }

    public void Dispose()
    {
        _dialogService.OnChange -= HandleChange;
    }
}
