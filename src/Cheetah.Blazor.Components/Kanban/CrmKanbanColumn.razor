@namespace Cheetah.Blazor.Components.Kanban
@typeparam TItem
@implements IDisposable

@* Kanban column component *@

<div class="crm-kanban-column @(IsDropTarget ? "drop-target" : "") @CssClass"
     @ondragover="HandleDragOver"
     @ondragover:preventDefault="true"
     @ondragleave="HandleDragLeave"
     @ondrop="HandleDrop">

    <div class="crm-kanban-column-header @HeaderVariantClass">
        @if (HeaderTemplate != null)
        {
            @HeaderTemplate
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center">
                <span class="crm-kanban-column-title">
                    @if (!string.IsNullOrEmpty(Icon))
                    {
                        <i class="bi bi-@Icon me-2"></i>
                    }
                    @Title
                </span>
                @if (ShowCount)
                {
                    <span class="badge bg-secondary">@_itemsList.Count</span>
                }
            </div>
        }
    </div>

    <div class="crm-kanban-column-body">
        <CascadingValue Value="this" IsFixed="true">
            @{ var index = 0; }
            @foreach (var item in _itemsList)
            {
                var currentIndex = index;
                <div class="crm-kanban-drop-zone @(DropTargetIndex == currentIndex ? "active" : "")"
                     @ondragover="e => HandleCardDragOver(e, currentIndex)"
                     @ondragover:preventDefault="true"
                     @ondrop="e => HandleCardDrop(e, currentIndex)"
                     @ondrop:preventDefault="true">
                </div>
                <CrmKanbanCard @key="item"
                               TItem="TItem"
                               Item="item"
                               ItemIndex="currentIndex"
                               CardTemplate="Board?.CardTemplate"
                               OnClick="HandleCardClick" />
                index++;
            }
            @* Final drop zone *@
            <div class="crm-kanban-drop-zone @(DropTargetIndex == _itemsList.Count ? "active" : "")"
                 @ondragover="e => HandleCardDragOver(e, _itemsList.Count)"
                 @ondragover:preventDefault="true"
                 @ondrop="e => HandleCardDrop(e, _itemsList.Count)"
                 @ondrop:preventDefault="true">
            </div>
        </CascadingValue>

        @if (!_itemsList.Any())
        {
            <div class="crm-kanban-empty">
                @(EmptyText ?? "No items")
            </div>
        }
    </div>

    @if (FooterTemplate != null)
    {
        <div class="crm-kanban-column-footer">
            @FooterTemplate
        </div>
    }
</div>

@code {
    private List<TItem> _itemsList = new();

    /// <summary>
    /// Column identifier
    /// </summary>
    [Parameter]
    public string Id { get; set; } = "";

    /// <summary>
    /// Column title
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "";

    /// <summary>
    /// Bootstrap icon name
    /// </summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>
    /// Items in this column
    /// </summary>
    [Parameter]
    public IEnumerable<TItem> Items { get; set; } = Enumerable.Empty<TItem>();

    /// <summary>
    /// Show item count badge
    /// </summary>
    [Parameter]
    public bool ShowCount { get; set; } = true;

    /// <summary>
    /// Header color variant
    /// </summary>
    [Parameter]
    public ColorVariant? HeaderVariant { get; set; }

    /// <summary>
    /// Text when column is empty
    /// </summary>
    [Parameter]
    public string? EmptyText { get; set; }

    /// <summary>
    /// Custom header template
    /// </summary>
    [Parameter]
    public RenderFragment? HeaderTemplate { get; set; }

    /// <summary>
    /// Custom footer template
    /// </summary>
    [Parameter]
    public RenderFragment? FooterTemplate { get; set; }

    /// <summary>
    /// Additional CSS classes
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Can items be dropped in this column
    /// </summary>
    [Parameter]
    public bool AllowDrop { get; set; } = true;

    [CascadingParameter]
    internal CrmKanbanBoard<TItem>? Board { get; set; }

    internal bool IsDropTarget { get; set; }
    internal int DropTargetIndex { get; set; } = -1;

    private string HeaderVariantClass => HeaderVariant.HasValue
        ? $"bg-{HeaderVariant.Value.ToCssClass()} text-white"
        : "";

    protected override void OnInitialized()
    {
        Board?.RegisterColumn(this);
    }

    protected override void OnParametersSet()
    {
        _itemsList = Items.ToList();
    }

    public void Dispose()
    {
        Board?.UnregisterColumn(this);
    }

    private void HandleDragOver(DragEventArgs e)
    {
        if (!AllowDrop || Board?.IsDragging != true) return;
        IsDropTarget = true;
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        IsDropTarget = false;
        DropTargetIndex = -1;
    }

    private async Task HandleDrop(DragEventArgs e)
    {
        IsDropTarget = false;
        var targetIndex = DropTargetIndex >= 0 ? DropTargetIndex : _itemsList.Count;
        DropTargetIndex = -1;

        if (!AllowDrop || Board?.IsDragging != true) return;

        await Board.DropItem(this, targetIndex);
    }

    private void HandleCardDragOver(DragEventArgs e, int index)
    {
        if (!AllowDrop || Board?.IsDragging != true) return;
        IsDropTarget = true;
        DropTargetIndex = index;
    }

    private async Task HandleCardDrop(DragEventArgs e, int index)
    {
        if (!AllowDrop || Board?.IsDragging != true) return;

        IsDropTarget = false;
        DropTargetIndex = -1;

        await Board.DropItem(this, index);
    }

    private async Task HandleCardClick(TItem item)
    {
        if (Board != null)
        {
            await Board.HandleCardClick(item);
        }
    }
}
