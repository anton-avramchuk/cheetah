@typeparam TGridViewModel where TGridViewModel : class, IHasId
@typeparam TDetailsViewModel where TDetailsViewModel : class, new()
@typeparam TCreateViewModel where TCreateViewModel : class, new()

@inject IDialogService DialogService
@inject IToastService ToastService
@inject NavigationManager Navigation

<div class="crm-grid">

    <div class="crm-grid-toolbar">
        @if (!string.IsNullOrEmpty(Title))
        {
            <h3 class="crm-grid-title">@Title</h3>
        }
        <div class="crm-grid-toolbar-actions">
            @if (ShowCreate)
            {
                <button class="crm-btn crm-btn-primary" @onclick="OnCreateClickAsync">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    @CreateButtonLabel
                </button>
            }
            @ToolbarActions
        </div>
    </div>

    <table class="crm-grid-table">
        <thead>
            <tr>
                @foreach (var col in _columns)
                {
                    <th>@col.Label</th>
                }
                @if (ShowActionsColumn)
                {
                    <th class="crm-grid-actions-header"></th>
                }
            </tr>
        </thead>
        <tbody>
            @if (_loading)
            {
                <tr>
                    <td colspan="@ColumnSpan" class="crm-grid-loading">Загрузка…</td>
                </tr>
            }
            else if (_items.Count == 0)
            {
                <tr>
                    <td colspan="@ColumnSpan" class="crm-grid-empty">Нет данных</td>
                </tr>
            }
            else
            {
                @foreach (var row in _items)
                {
                    var capturedRow = row;
                    <tr class="@(OnRowClick.HasDelegate ? "crm-grid-row-clickable" : null)"
                        @onclick="@(() => OnRowClick.InvokeAsync(capturedRow))">
                        @foreach (var col in _columns)
                        {
                            <td>@GetValue(capturedRow, col.PropertyName)</td>
                        }
                        @if (ShowActionsColumn)
                        {
                            <td class="crm-grid-actions" @onclick:stopPropagation="true">
                                @RowActions?.Invoke(capturedRow)
                                @if (ShowEdit)
                                {
                                    <button class="crm-btn crm-btn-icon crm-btn-edit" title="Редактировать"
                                            @onclick="@(async () => await OnEditClickAsync(capturedRow.Id))">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </button>
                                }
                                @if (ShowDelete)
                                {
                                    <button class="crm-btn crm-btn-icon crm-btn-danger" title="Удалить"
                                            @onclick="@(async () => await OnDeleteClickAsync(capturedRow.Id))">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                            <path d="M10 11v6M14 11v6"/>
                                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                                        </svg>
                                    </button>
                                }
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>

    <CrmPager Page="_page"
              TotalPages="_totalPages"
              Total="_total"
              PageSize="_pageSize"
              Loading="_loading"
              OnPageChange="GoToPageAsync"
              OnPageSizeChange="ChangePageSizeAsync" />

</div>

@code {
    private sealed record ColumnInfo(string PropertyName, string Label, int Order);

    [Parameter, EditorRequired] public ICrudService<TGridViewModel, TDetailsViewModel, TCreateViewModel> Service { get; set; } = null!;
    [Parameter] public Type? EditFormType   { get; set; }
    [Parameter] public Type? CreateFormType { get; set; }
    [Parameter] public string Title    { get; set; } = string.Empty;
    [Parameter] public int    PageSize { get; set; } = 20;

    /// <summary>Optional extra per-row action buttons rendered before the built-in edit/delete buttons.</summary>
    [Parameter] public RenderFragment<TGridViewModel>? RowActions { get; set; }

    /// <summary>Optional extra toolbar content rendered after the "Create" button.</summary>
    [Parameter] public RenderFragment? ToolbarActions { get; set; }

    /// <summary>Optional factory for the model passed to the create dialog (e.g. to prefill fields). Defaults to <c>new()</c>.</summary>
    [Parameter] public Func<TCreateViewModel>? CreateModelFactory { get; set; }

    /// <summary>When true, opens the create dialog once after the first render (e.g. deep-link "create for X"). Ignored when <see cref="CreateUrl"/> is set.</summary>
    [Parameter] public bool AutoOpenCreate { get; set; }

    /// <summary>Optional fixed width (px) for the create/edit dialogs. Default null = dialog's own sizing.</summary>
    [Parameter] public int? DialogWidthPx { get; set; }

    // --- Toolbar / actions visibility ---
    [Parameter] public bool ShowCreate { get; set; } = true;
    [Parameter] public bool ShowEdit   { get; set; } = true;
    [Parameter] public bool ShowDelete { get; set; } = true;
    [Parameter] public string CreateButtonLabel { get; set; } = "Создать";
    [Parameter] public string CreateDialogTitle { get; set; } = "Создать";
    [Parameter] public string EditDialogTitle   { get; set; } = "Редактировать";

    // --- Navigate to a page instead of opening a dialog ---
    /// <summary>If set, the "Create" button navigates to this URL instead of opening the create dialog.</summary>
    [Parameter] public string? CreateUrl { get; set; }
    /// <summary>If set, the edit button navigates to <c>EditUrl(id)</c> instead of opening the edit dialog.</summary>
    [Parameter] public Func<Guid, string>? EditUrl { get; set; }

    // --- Outward lifecycle callbacks (carry the affected row id) ---
    [Parameter] public EventCallback<Guid> OnCreated { get; set; }
    [Parameter] public EventCallback<Guid> OnUpdated { get; set; }
    [Parameter] public EventCallback<Guid> OnDeleted { get; set; }

    /// <summary>Optional row-click handler (e.g. open a details page). Action buttons stop propagation.</summary>
    [Parameter] public EventCallback<TGridViewModel> OnRowClick { get; set; }

    private bool _autoOpenHandled;

    private DialogDimension? DialogWidth => DialogWidthPx is { } px ? new DialogDimension.Pixels(px) : null;

    private bool ShowActionsColumn => ShowEdit || ShowDelete || RowActions is not null;
    private int  ColumnSpan        => _columns.Count + (ShowActionsColumn ? 1 : 0);

    private List<TGridViewModel> _items = [];
    private int  _total;
    private int  _page     = 1;
    private int  _pageSize;
    private bool _loading;

    private int _totalPages => _total == 0 ? 1 : (int)Math.Ceiling((double)_total / _pageSize);

    private static readonly IReadOnlyList<ColumnInfo> _columns = BuildColumns();

    protected override async Task OnInitializedAsync()
    {
        _pageSize = PageSize;
        await LoadAsync();
    }

    private static IReadOnlyList<ColumnInfo> BuildColumns()
        => typeof(TGridViewModel)
            .GetProperties()
            .Select(p => (Prop: p, Attr: p.GetCustomAttribute<GridColumnAttribute>()))
            .Where(x => x.Attr is { Show: true })
            .OrderBy(x => x.Attr!.Order)
            .Select(x => new ColumnInfo(x.Prop.Name, x.Attr!.Label, x.Attr!.Order))
            .ToList();

    private static object? GetValue(TGridViewModel item, string propertyName)
        => typeof(TGridViewModel).GetProperty(propertyName)?.GetValue(item);

    /// <summary>Reloads the current page from the service. Useful via <c>@ref</c> after external changes.</summary>
    public Task RefreshAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var result = await Service.GetGridAsync(new CrmPageRequest { Page = _page, PageSize = _pageSize });
            _items = result.Data.ToList();
            _total = result.Total;
        }
        catch (Exception ex)
        {
            _items = [];
            _total = 0;
            ToastService.Error($"Не удалось загрузить данные: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AutoOpenCreate && CreateUrl is null && !_autoOpenHandled)
        {
            _autoOpenHandled = true;
            await OnCreateClickAsync();
        }
    }

    private async Task OnCreateClickAsync()
    {
        // Page mode: navigate instead of opening the dialog.
        if (CreateUrl is not null)
        {
            Navigation.NavigateTo(CreateUrl);
            return;
        }

        var model = CreateModelFactory?.Invoke() ?? new TCreateViewModel();
        var createdId = Guid.Empty;
        var result = await DialogService.ShowAsync(new DialogOptions
        {
            Title             = CreateDialogTitle,
            ContentType       = CreateFormType,
            ContentParameters = new Dictionary<string, object> { ["Model"] = model },
            Width             = DialogWidth,
            Commands          = BuildSaveCommands(async () => createdId = await Service.CreateAsync(model))
        });
        if (result.IsOk)
        {
            _page = 1;
            await LoadAsync();
            ToastService.Success("Запись успешно создана");
            await OnCreated.InvokeAsync(createdId);
        }
    }

    private async Task OnEditClickAsync(Guid id)
    {
        // Page mode: navigate instead of opening the dialog.
        if (EditUrl is not null)
        {
            Navigation.NavigateTo(EditUrl(id));
            return;
        }

        TDetailsViewModel? model;
        try
        {
            model = await Service.GetByIdAsync(id);
        }
        catch (Exception ex)
        {
            ToastService.Error($"Не удалось загрузить запись: {ex.Message}");
            return;
        }

        if (model is null) return;

        var result = await DialogService.ShowAsync(new DialogOptions
        {
            Title             = EditDialogTitle,
            ContentType       = EditFormType,
            ContentParameters = new Dictionary<string, object> { ["Model"] = model },
            Width             = DialogWidth,
            Commands          = BuildSaveCommands(() => Service.UpdateAsync(id, model))
        });
        if (result.IsOk)
        {
            await LoadAsync();
            ToastService.Success("Запись успешно обновлена");
            await OnUpdated.InvokeAsync(id);
        }
    }

    // Saves inside the dialog so a failure keeps the form open with the user's input
    // and surfaces the error inline; the dialog closes only on success.
    private static IReadOnlyList<IDialogCommand> BuildSaveCommands(Func<Task> save) =>
    [
        new DialogCommand("ok", "Сохранить", IsPrimary: true, OnExecute: async ctx =>
        {
            ctx.ShowError(null);
            try
            {
                await save();
                await ctx.CloseAsync("ok");
            }
            catch (Exception ex)
            {
                ctx.ShowError(ex.Message);
            }
        }),
        DialogCommands.Cancel
    ];

    private async Task OnDeleteClickAsync(Guid id)
    {
        var confirmed = await DialogService.ConfirmAsync("Удалить эту запись?", "Удаление");
        if (!confirmed) return;

        try
        {
            await Service.DeleteAsync(id);
            if (_page > 1 && _items.Count == 1)
                _page--;
            await LoadAsync();
            ToastService.Success("Запись успешно удалена");
            await OnDeleted.InvokeAsync(id);
        }
        catch (Exception ex)
        {
            ToastService.Error($"Не удалось удалить запись: {ex.Message}");
        }
    }

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task ChangePageSizeAsync(int size)
    {
        _pageSize = size;
        _page = 1;
        await LoadAsync();
    }
}
