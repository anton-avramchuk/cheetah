@using Cheetah.Core.CQRS
@using Cheetah.Identity.Frontend.Client.Queries
@using Cheetah.Identity.Shared.ViewModels
@inject IDispatcher Dispatcher

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3>Users</h3>
        <button class="btn btn-primary btn-sm" @onclick="LoadUsers">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </div>
    <div class="card-body">
        @if (_isLoading)
        {
            <div class="text-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (_errorMessage != null)
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }
        else if (_users == null || !_users.Any())
        {
            <p class="text-muted">No users found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Email Confirmed</th>
                            <th>Last Login</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in _users)
                        {
                            <tr>
                                <td>@user.Email</td>
                                <td>@user.FirstName @user.LastName</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @if (user.EmailConfirmed)
                                    {
                                        <i class="bi bi-check-circle text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle text-danger"></i>
                                    }
                                </td>
                                <td>
                                    @if (user.LastLoginAt.HasValue)
                                    {
                                        @user.LastLoginAt.Value.ToString("g")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Never</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-primary" @onclick="() => ViewUserDetails(user.Id)">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<UserViewModel>? _users;
    private bool _isLoading;
    private string? _errorMessage;

    [Parameter]
    public EventCallback<Guid> OnUserSelected { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;

            var query = new GetAllUsersQuery();
            _users = await Dispatcher.QueryAsync<GetAllUsersQuery,List<UserViewModel>>(query);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading users: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ViewUserDetails(Guid userId)
    {
        await OnUserSelected.InvokeAsync(userId);
    }
}
