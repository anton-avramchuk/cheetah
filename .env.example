# Copy this file to .env and fill in the values before running docker-compose.

# JWT — must be shared across all API services (identity, recruitment, candidates, vacancytasks)
# SecretKey must be at least 32 characters long
JWT_SECRET_KEY=replace-with-a-strong-secret-key-min-32-chars
JWT_ISSUER=cheetah-crm
JWT_AUDIENCE=cheetah-crm-api
